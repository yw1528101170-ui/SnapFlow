<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jietu.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="钉在桌面">
    <Grid x:Name="Root" Background="#01000000"
          KeyDown="OnKey"
          PointerPressed="OnPressed"
          PointerMoved="OnMoved"
          PointerReleased="OnReleased"
          PointerWheelChanged="OnWheel"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- 深色：柔和玻璃 + 高对比字形 -->
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="PinBarShadowBrush" Color="#7A000000"/>
                        <SolidColorBrush x:Key="PinBarBgBrush" Color="#F01A1A1D"/>
                        <SolidColorBrush x:Key="PinBarBorderBrush" Color="#26FFFFFF"/>
                        <SolidColorBrush x:Key="PinToolGlyphBrush" Color="#F5F5F7"/>
                        <SolidColorBrush x:Key="PinToolHoverBrush" Color="#1FFFFFFF"/>
                        <SolidColorBrush x:Key="PinToolPressedBrush" Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="PinDividerBrush" Color="#26FFFFFF"/>
                        <SolidColorBrush x:Key="PinEdgeBrush" Color="#3DFFFFFF"/>
                        <SolidColorBrush x:Key="PinEdgeGlossBrush" Color="#12FFFFFF"/>
                        <SolidColorBrush x:Key="PinGrabberBrush" Color="#4DFFFFFF"/>
                        <SolidColorBrush x:Key="PinHudBgBrush" Color="#E81C1C1E"/>
                        <SolidColorBrush x:Key="PinHudBorderBrush" Color="#2EFFFFFF"/>
                    </ResourceDictionary>
                    <!-- 浅色：Apple 浅色界面（系统分组背景） -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PinBarShadowBrush" Color="#2E000000"/>
                        <SolidColorBrush x:Key="PinBarBgBrush" Color="#F5F2F2F7"/>
                        <SolidColorBrush x:Key="PinBarBorderBrush" Color="#1F000000"/>
                        <SolidColorBrush x:Key="PinToolGlyphBrush" Color="#1C1C1E"/>
                        <SolidColorBrush x:Key="PinToolHoverBrush" Color="#14000000"/>
                        <SolidColorBrush x:Key="PinToolPressedBrush" Color="#24000000"/>
                        <SolidColorBrush x:Key="PinDividerBrush" Color="#1A000000"/>
                        <SolidColorBrush x:Key="PinEdgeBrush" Color="#33000000"/>
                        <SolidColorBrush x:Key="PinEdgeGlossBrush" Color="#B3FFFFFF"/>
                        <SolidColorBrush x:Key="PinGrabberBrush" Color="#4D000000"/>
                        <SolidColorBrush x:Key="PinHudBgBrush" Color="#F2FFFFFF"/>
                        <SolidColorBrush x:Key="PinHudBorderBrush" Color="#1A000000"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <!-- 关闭按钮：常态只有一枚细 × ，悬停才浮出柔和红底 -->
                <Style x:Key="PinCloseButton" TargetType="Button">
                    <Setter Property="Width" Value="26"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="13"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Border x:Name="Plate" Background="#26EF4444" CornerRadius="13" Opacity="0"/>
                                    <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="18" Height="18">
                                            <Path x:Name="Cross" Data="M 4.5,4.5 L 13.5,13.5 M 13.5,4.5 L 4.5,13.5"
                                                  Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition To="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                                <VisualTransition To="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                                    </Storyboard>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                    <Setter Target="Cross.Stroke" Value="#FF6B6B"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                    <Setter Target="Plate.Background" Value="#3DEF4444"/>
                                                    <Setter Target="Cross.Stroke" Value="#EF4444"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 胶囊工具条内的图标按钮：圆形柔和高亮 -->
                <Style x:Key="PinToolButton" TargetType="Button">
                    <Setter Property="Width" Value="26"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="13"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Border x:Name="Plate" Background="{ThemeResource PinToolHoverBrush}" CornerRadius="13" Opacity="0"/>
                                    <ContentPresenter x:Name="GlyphHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition To="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                                <VisualTransition To="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource PinToolPressedBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 缩放徽章 -->
                <Style x:Key="PinBadgeButton" TargetType="Button">
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Padding" Value="9,0"/>
                    <Setter Property="MinWidth" Value="46"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Border x:Name="Plate" Background="{ThemeResource PinToolHoverBrush}" CornerRadius="12" Opacity="0"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition To="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualTransition>
                                                <VisualTransition To="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                                    </Storyboard>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value="1"/>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource PinToolPressedBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="复制图片 (Ctrl+C)" Click="OnCopy">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="另存为... (Ctrl+S)" Click="OnSaveAs">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="提取文字 (OCR)" Click="OnOcr">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C1;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="AI 视觉分析" Click="OnAiVision">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="吸管拾色 (C)" Click="OnPickColor">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEF3C;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="重置大小与透明度 (0)" Click="OnReset">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE777;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="幽灵穿透模式 (F3 / G)" Click="OnToggleGhost">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE727;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="放大 (滚轮上 / +)" Click="OnZoomIn">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE71E;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="缩小 (滚轮下 / -)" Click="OnZoomOut">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE71F;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="关闭贴图 (Esc)" Click="OnClose">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- ===== 画面舞台：入场缩放与淡入都作用于此层 ===== -->
        <Grid x:Name="Stage" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="StageTr" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Image x:Name="Picture" Stretch="Uniform" IsHitTestVisible="False"/>

            <!-- ===== Apple 便签（浮纸质感） ===== -->
            <Grid x:Name="NoteContainer" Visibility="Collapsed">
                <Border x:Name="NotePaper" BorderThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFEFBF2" Offset="0"/>
                            <GradientStop Color="#FFFDF6E3" Offset="0.55"/>
                            <GradientStop Color="#FFFAF0D6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 便签标题栏（可拖拽区域） -->
                        <Grid Background="Transparent" Padding="12,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Viewbox Width="11" Height="11">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 4,2 H 12 L 14,4 V 14 H 2 V 4 Z M 4,6 H 12 M 4,9 H 12 M 4,12 H 9"
                                              Stroke="#A38C4E" StrokeThickness="1.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="便签" FontSize="11.5" FontWeight="SemiBold" Foreground="#A38C4E"
                                           FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
                                <Border Width="2.5" Height="2.5" CornerRadius="1.5" Background="#40A38C4E"
                                        VerticalAlignment="Center" Margin="1,0"/>
                                <TextBlock x:Name="NoteMeta" VerticalAlignment="Center"
                                           FontSize="10.5" Foreground="#C0AE80"
                                           FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#14000000"/>

                        <TextBox x:Name="NoteTextBox" Grid.Row="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontSize="13.5"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#2C2820"
                                 PlaceholderForeground="#B9A87C"
                                 Padding="12,6,12,12"
                                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnNoteTextChanged"
                                 PlaceholderText="写点什么…"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 边缘：极细发丝线 + 内侧高光 ===== -->
            <Border x:Name="EdgeLine" BorderBrush="{ThemeResource PinEdgeBrush}" BorderThickness="1"
                    IsHitTestVisible="False" Opacity="0.75"/>
            <Border x:Name="EdgeGloss" Margin="1" BorderBrush="{ThemeResource PinEdgeGlossBrush}" BorderThickness="1"
                    IsHitTestVisible="False"/>
        </Grid>

        <!-- ===== 拖拽抓握条（悬停时淡入） ===== -->
        <Border x:Name="Grabber" Width="34" Height="4" CornerRadius="2"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"
                Background="{ThemeResource PinGrabberBrush}" Opacity="0" IsHitTestVisible="False"/>

        <!-- ===== 幽灵模式呼吸描边 ===== -->
        <Border x:Name="GhostGlow" Visibility="Collapsed" IsHitTestVisible="False"
                BorderBrush="{ThemeResource SnapFlowAccentBrush}" BorderThickness="1.5" Opacity="0.7"/>

        <!-- ===== 幽灵模式指示器 ===== -->
        <Border x:Name="GhostIndicator" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                Background="{ThemeResource PinBarBgBrush}" BorderBrush="{ThemeResource PinBarBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="10,5" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Grid Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource SnapFlowAccentBrush}" Width="8" Height="8" Opacity="0.28"/>
                    <Ellipse x:Name="GhostDot" Fill="{ThemeResource SnapFlowAccentBrush}" Width="5.5" Height="5.5"/>
                </Grid>
                <TextBlock Text="穿透中 · 托盘可恢复" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource PinToolGlyphBrush}"
                           FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
            </StackPanel>
        </Border>

        <!-- ===== 悬浮胶囊工具条（macOS 风） ===== -->
        <Grid x:Name="HoverBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
              Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.85,0.2">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="BarTr" ScaleX="0.94" ScaleY="0.94" TranslateY="-4"/>
            </Grid.RenderTransform>

            <!-- 弥散投影（多层叠加模拟柔和光学阴影） -->
            <Border CornerRadius="17" Background="{ThemeResource PinBarShadowBrush}" Opacity="0.45"
                    Margin="2,5,2,-6" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.9"/>
                </Border.RenderTransform>
            </Border>
            <Border CornerRadius="17" Background="{ThemeResource PinBarShadowBrush}" Opacity="0.28"
                    Margin="6,10,6,-11" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.92" ScaleY="0.8"/>
                </Border.RenderTransform>
            </Border>

            <Border Background="{ThemeResource PinBarBgBrush}" BorderBrush="{ThemeResource PinBarBorderBrush}"
                    BorderThickness="1" CornerRadius="17" Padding="5,4">
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                    <!-- 缩放 / 不透明度徽章 -->
                    <Button x:Name="StatusBadge" Style="{StaticResource PinBadgeButton}"
                            ToolTipService.ToolTip="点击重置 (0)；在此滚轮或按住 Ctrl / Shift 滚轮可调透明度" Click="OnReset">
                        <TextBlock x:Name="StatusText" Text="100%" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PinToolGlyphBrush}"
                                   FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
                    </Button>

                    <Border Width="1" Height="13" VerticalAlignment="Center" Margin="4,0"
                            Background="{ThemeResource PinDividerBrush}"/>

                    <!-- 复制 -->
                    <Button Style="{StaticResource PinToolButton}" Click="OnCopy" ToolTipService.ToolTip="复制图片 (Ctrl+C / 双击)">
                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Data="M 4.5,5.5 H 11 A 1.5,1.5 0 0 1 12.5,7 V 14.5 A 1.5,1.5 0 0 1 11,16 H 4.5 A 1.5,1.5 0 0 1 3,14.5 V 7 A 1.5,1.5 0 0 1 4.5,5.5 Z"
                                      Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M 7,5.5 V 3.5 A 1.5,1.5 0 0 1 8.5,2 H 14.5 A 1.5,1.5 0 0 1 16,3.5 V 11 A 1.5,1.5 0 0 1 14.5,12.5 H 12.5"
                                      Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 工具组：窗口过窄时自动收起 -->
                    <StackPanel x:Name="ToolGroup" Orientation="Horizontal" Spacing="1">
                        <Button x:Name="OcrBtn" Style="{StaticResource PinToolButton}" Click="OnOcr" ToolTipService.ToolTip="提取文字 (OCR)">
                            <FontIcon Glyph="&#xE8C1;" FontSize="11.5" Foreground="{ThemeResource PinToolGlyphBrush}"/>
                        </Button>
                        <Button x:Name="AiBtn" Style="{StaticResource PinToolButton}" Click="OnAiVision" ToolTipService.ToolTip="AI 视觉分析">
                            <FontIcon Glyph="&#xE946;" FontSize="11.5" Foreground="{ThemeResource SnapFlowAccentBrush}"/>
                        </Button>
                        <Button x:Name="PickColorBtn" Style="{StaticResource PinToolButton}" Click="OnPickColor" ToolTipService.ToolTip="吸管拾色 (C)">
                            <FontIcon Glyph="&#xEF3C;" FontSize="11.5" Foreground="{ThemeResource PinToolGlyphBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PinToolButton}" Click="OnSaveAs" ToolTipService.ToolTip="另存为… (Ctrl+S)">
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M 3.5,8.5 V 13.5 A 1.5,1.5 0 0 0 5,15 H 13 A 1.5,1.5 0 0 0 14.5,13.5 V 8.5"
                                          Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M 9,3 V 11.5 M 5.8,8.2 L 9,11.5 L 12.2,8.2"
                                          Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <Border x:Name="ToolDivider" Width="1" Height="13" VerticalAlignment="Center" Margin="4,0"
                            Background="{ThemeResource PinDividerBrush}"/>

                    <!-- 幽灵穿透 -->
                    <Button x:Name="GhostBtn" Style="{StaticResource PinToolButton}" Click="OnToggleGhost"
                            ToolTipService.ToolTip="幽灵穿透模式 (F3 / G) — 鼠标点击完全穿透贴图">
                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Data="M 9,2.5 C 5.5,2.5 3.5,5.5 3.5,9 V 15.5 L 5.5,14 L 7.5,15.5 L 9.5,14 L 11.5,15.5 L 13.5,14 L 14.5,15.5 V 9 C 14.5,5.5 12.5,2.5 9,2.5 Z"
                                      Stroke="{ThemeResource PinToolGlyphBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="6.1" Canvas.Top="7.1" Width="1.4" Height="1.4" Fill="{ThemeResource PinToolGlyphBrush}"/>
                                <Ellipse Canvas.Left="10.5" Canvas.Top="7.1" Width="1.4" Height="1.4" Fill="{ThemeResource PinToolGlyphBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="13" VerticalAlignment="Center" Margin="4,0"
                            Background="{ThemeResource PinDividerBrush}"/>

                    <!-- 关闭 -->
                    <Button Style="{StaticResource PinCloseButton}" Click="OnClose" ToolTipService.ToolTip="关闭贴图 (Esc)"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== HUD：缩放 / 透明度 / 操作反馈（Apple 风浮层） ===== -->
        <Border x:Name="Hud" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource PinHudBgBrush}" BorderBrush="{ThemeResource PinHudBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="16,9"
                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <CompositeTransform x:Name="HudTr" ScaleX="0.9" ScaleY="0.9"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock x:Name="HudText" Text="已复制" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource PinToolGlyphBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
