<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jietu.PasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jietu"
    Title="密码库">
    <!--
        观感对齐设置中枢与剪贴板历史：浅色内容底 + 白卡片 + 品牌蓝强调。
        分层：①48px 一体化标题栏（品牌釉块 + 标题/条目数）②搜索胶囊 ③等宽分段 + 排序
        ④列表 / 详情 ⑤底部快捷键提示 —— 与 HistoryWindow 的骨架逐行对应。
    -->
    <Grid x:Name="Root" Background="{ThemeResource SetContentFillBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#402D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A6FFFFFF"/>

                        <!-- 未保存徽标（琥珀）与行尾语义小图标 -->
                        <SolidColorBrush x:Key="VaultBadgeFillBrush" Color="#2EF59E0B"/>
                        <SolidColorBrush x:Key="VaultBadgeFgBrush" Color="#FBBF24"/>
                        <SolidColorBrush x:Key="VaultFaintGlyphBrush" Color="#66FFFFFF"/>

                        <!-- 解锁页：错误 / 警告条、品牌釉块描边（深色） -->
                        <SolidColorBrush x:Key="VaultErrorFillBrush" Color="#26EF4444"/>
                        <SolidColorBrush x:Key="VaultErrorStrokeBrush" Color="#3DEF4444"/>
                        <SolidColorBrush x:Key="VaultErrorFgBrush" Color="#FCA5A5"/>
                        <SolidColorBrush x:Key="VaultWarnFillBrush" Color="#26F59E0B"/>
                        <SolidColorBrush x:Key="VaultWarnStrokeBrush" Color="#3DF59E0B"/>
                        <SolidColorBrush x:Key="VaultWarnFgBrush" Color="#FCD34D"/>
                        <SolidColorBrush x:Key="VaultTileStrokeBrush" Color="#262D6EFA"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#402D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A6FFFFFF"/>

                        <SolidColorBrush x:Key="VaultBadgeFillBrush" Color="#1FF59E0B"/>
                        <SolidColorBrush x:Key="VaultBadgeFgBrush" Color="#B45309"/>
                        <SolidColorBrush x:Key="VaultFaintGlyphBrush" Color="#4D000000"/>

                        <!-- 解锁页：错误 / 警告条、品牌釉块描边（浅色） -->
                        <SolidColorBrush x:Key="VaultErrorFillBrush" Color="#14EF4444"/>
                        <SolidColorBrush x:Key="VaultErrorStrokeBrush" Color="#33EF4444"/>
                        <SolidColorBrush x:Key="VaultErrorFgBrush" Color="#B91C1C"/>
                        <SolidColorBrush x:Key="VaultWarnFillBrush" Color="#14F59E0B"/>
                        <SolidColorBrush x:Key="VaultWarnStrokeBrush" Color="#33F59E0B"/>
                        <SolidColorBrush x:Key="VaultWarnFgBrush" Color="#B45309"/>
                        <SolidColorBrush x:Key="VaultTileStrokeBrush" Color="#1F2D6EFA"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <!-- 内嵌分组卡片：12 圆角 + 发丝描边（同 SettingsCardStyle） -->
                <Style x:Key="VaultCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource SetCardFillBrush}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource SetCardStrokeBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>

                <!-- 分组小标题（同 SettingsGroupLabelStyle） -->
                <Style x:Key="VaultGroupLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="CharacterSpacing" Value="20"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Setter Property="Margin" Value="3,0,0,1"/>
                </Style>

                <!--
                   解锁页的主密码输入框：外层 Border 自绘胶囊外壳（图标 + 焦点环），
                   内层 PasswordBox 彻底扁平化，只保留输入与光标 —— 同 VaultSearchBoxStyle 同构。
                   默认模板的「下划线 + 聚焦色边框」会把外壳顶穿，所以这里整套换模板。
                -->
                <Style x:Key="VaultFieldStyle" TargetType="PasswordBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0,0,6,0"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="PasswordRevealMode" Value="Hidden"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="PasswordBox">
                                <Grid Background="Transparent" VerticalAlignment="Center">
                                    <ScrollViewer x:Name="ContentElement"
                                                  Background="Transparent"
                                                  Padding="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsTabStop="False"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                    <ContentPresenter x:Name="PlaceholderTextContentPresenter"
                                                      Content="{TemplateBinding PlaceholderText}"
                                                      Padding="{TemplateBinding Padding}"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--
                    解锁页的「快速解锁」磁贴：图标 + 两行文字 + 尾部箭头的一整块可点区域。
                    悬停/按下只做底色递进，不抢下方主按钮的品牌蓝。
                -->
                <Style x:Key="VaultHelloTileStyle" TargetType="Button">
                    <Setter Property="MinHeight" Value="54"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="CornerRadius" Value="11"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="TileRoot" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.13">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="TilePlate.Background" Value="{ThemeResource HistRowHoverBrush}"/>
                                                    <Setter Target="TilePlate.BorderBrush" Value="{ThemeResource VaultTileStrokeBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="TilePlate.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                    <Setter Target="TilePlate.BorderBrush" Value="{ThemeResource VaultTileStrokeBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="TilePlate.Opacity" Value="0.5"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="TilePlate"
                                            Background="{ThemeResource HistFieldFillBrush}"
                                            BorderBrush="{ThemeResource SetCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 圆角胶囊徽标：标题栏「已锁定」等状态标记 -->
                <Style x:Key="VaultPillStyle" TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="7,2"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                </Style>

                <!--
                    搜索胶囊：外层 Border 自绘外壳（图标 + 键帽提示 + 清除按钮），
                    内层 TextBox 彻底扁平化，只负责输入与光标 —— 与 HistSearchBoxStyle 同构。
                -->
                <Style x:Key="VaultSearchBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Grid Background="Transparent">
                                    <ScrollViewer x:Name="ContentElement"
                                                  Background="Transparent"
                                                  Padding="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsTabStop="False"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                    <ContentPresenter x:Name="PlaceholderTextContentPresenter"
                                                      Content="{TemplateBinding PlaceholderText}"
                                                      Padding="{TemplateBinding Padding}"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 搜索框内清除按钮：20 见方、无描边、有输入才出现 -->
                <Style x:Key="VaultClearButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Margin" Value="0,0,7,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Style>

                <!-- 卡片内的图标动作按钮（删除等）：30 见方、无描边 -->
                <Style x:Key="VaultIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Style>

                <!--
                    分段控件中的单个分段（Apple Segmented Control）：自绘模板保证文字严格居中；
                    选中态不靠染色，靠下方滑动的 SegThumb + 主文字色 / 半粗体 —— 同 HistSegmentStyle。
                -->
                <Style x:Key="VaultSegmentStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="CornerRadius" Value="7"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="SegmentRoot" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.12">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="SegmentRoot.Opacity" Value="0.4"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="HoverPlate" Background="Transparent"
                                            CornerRadius="{TemplateBinding CornerRadius}"/>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnAccNew"/>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnAccSearch"/>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAccSave"/>
            <KeyboardAccelerator Key="Delete" Invoked="OnAccDelete"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 内容底色垫层：WindowChrome 会把 Root 背景改为透明 + Mica，观感由本层决定 -->
        <Border Grid.RowSpan="2" Background="{ThemeResource SetContentFillBrush}"/>

        <!-- ============ 标题栏：与剪贴板历史同构 —— 品牌釉块 + 标题 / 条目数 + 锁定徽标（整条可拖拽） ============ -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource HistDividerBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBar" Height="48" Background="Transparent" Padding="14,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#7341F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="密码库" FontSize="14" FontWeight="SemiBold"
                                       CharacterSpacing="-12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Border x:Name="LockPill" Style="{StaticResource VaultPillStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="LockBadge" Text="已锁定" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="CountBadge" FontSize="10.5" Margin="0,-1,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 解锁 / 创建视图（锁定态显示） ============ -->
        <!--
            锁定态只做一件事：让人尽快开门。所以结构收敛为
            「品牌釉块 → 标题/一句说明 → 一张卡片（快速解锁 / 主密码 / 提示 / 主按钮）→ 加密标识」，
            快速解锁是推荐路径（磁贴 + 「或使用主密码」分隔线），主密码是兜底的那条路。
        -->
        <Grid x:Name="UnlockPanel" Grid.Row="1" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="372" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,6,16,20">

                    <!-- 品牌釉块：外层柔光晕 + 内层锁标记，让居中的小卡片不显得孤零零 -->
                    <Grid Width="92" Height="92" HorizontalAlignment="Center">
                        <Ellipse Width="92" Height="92">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#292D6EFA" Offset="0"/>
                                    <GradientStop Color="#002D6EFA" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Width="58" Height="58" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{ThemeResource HistBadgeFillBrush}"
                                BorderBrush="{ThemeResource VaultTileStrokeBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE72E;" FontSize="22" Foreground="{StaticResource SnapFlowAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="UnlockTitle" Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold"
                               CharacterSpacing="-12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="UnlockModeBadge" Margin="0,6,0,0" FontSize="11.5" LineHeight="17"
                               MaxWidth="330" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                    <Border Style="{StaticResource VaultCardStyle}" CornerRadius="14" Padding="16" Margin="0,16,0,0">
                        <StackPanel Spacing="12">

                            <!--
                                阻断卡：库文件存在但本版本无法打开（旧版 v1 / 版本过新 / 结构损坏）。
                                此时密码输入没有意义，所以整块输入区会被收起；但「路径 + 打开所在文件夹 +
                                用备份文件恢复」必须留着——用户的全部诉求就是"把我的数据拿回来"。
                                程序内不提供任何删除/覆盖/重置旧库的控件。
                            -->
                            <Border x:Name="BlockCard" Visibility="Collapsed" CornerRadius="9" Padding="12,10"
                                    Background="{ThemeResource VaultWarnFillBrush}"
                                    BorderBrush="{ThemeResource VaultWarnStrokeBrush}" BorderThickness="1">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Top"
                                                  Foreground="{ThemeResource VaultWarnFgBrush}"/>
                                        <TextBlock x:Name="BlockTitle" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource VaultWarnFgBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="BlockBody" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <!-- 路径可选中：用户第一件事就是把它复制出去做备份 -->
                                    <TextBlock x:Name="BlockPath" Visibility="Collapsed" FontSize="11" LineHeight="16"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BlockOpenFolderButton" Content="打开所在文件夹" FontSize="11.5"
                                                Click="OnOpenVaultFolder"/>
                                        <Button Content="用备份文件恢复" FontSize="11.5" Click="OnRecoverFromBackup"/>
                                        <Button Content="我已移走旧库，重试" FontSize="11.5" Click="OnRetryAfterMove"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 创建态：一句顶一万句的风险提示，放在所有输入之前 -->
                            <Border x:Name="CreateWarning" Visibility="Collapsed" CornerRadius="9" Padding="10,8"
                                    Background="{ThemeResource VaultWarnFillBrush}"
                                    BorderBrush="{ThemeResource VaultWarnStrokeBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Top"
                                              Foreground="{ThemeResource VaultWarnFgBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="11.5" LineHeight="16" TextWrapping="Wrap"
                                               Foreground="{ThemeResource VaultWarnFgBrush}"
                                               Text="忘记主密码等于永久丢失库内全部数据，请务必牢记。"/>
                                </Grid>
                            </Border>

                            <!-- 推荐路径：Windows Hello 快速解锁（仅本机有可用副本时出现） -->
                            <StackPanel x:Name="HelloBlock" Spacing="12" Visibility="Collapsed">
                                <Button x:Name="HelloButton" Style="{StaticResource VaultHelloTileStyle}"
                                        HorizontalAlignment="Stretch" Click="OnHelloClick"
                                        AutomationProperties.Name="使用 Windows Hello 解锁">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{ThemeResource HistBadgeFillBrush}">
                                            <FontIcon Glyph="&#xE928;" FontSize="13"
                                                      Foreground="{StaticResource SnapFlowAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="HelloButtonTitle" Text="使用 Windows Hello 解锁"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Name="HelloButtonSubtitle" Text="指纹 / PIN 快速解锁，免输主密码"
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <ProgressRing x:Name="HelloBusyRing" Grid.Column="2" Width="16" Height="16"
                                                      IsActive="False" Visibility="Collapsed"
                                                      Foreground="{StaticResource SnapFlowAccentBrush}"/>
                                        <FontIcon x:Name="HelloChevron" Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </Button>

                                <!-- 「或」分隔线：把两条路径的关系说明白，而不是两个按钮并排猜 -->
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                    <Rectangle Height="1" VerticalAlignment="Center"
                                               Fill="{ThemeResource HistDividerBrush}"/>
                                    <TextBlock Grid.Column="1" Text="或使用主密码" FontSize="10.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                               Fill="{ThemeResource HistDividerBrush}"/>
                                </Grid>
                            </StackPanel>

                            <!-- 兜底路径：主密码（外壳自绘胶囊，聚焦时才亮起品牌色描边） -->
                            <Border x:Name="MasterFieldShell" Height="38" CornerRadius="9"
                                    Background="{ThemeResource HistFieldFillBrush}"
                                    BorderBrush="{ThemeResource HistFieldStrokeBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <FontIcon Glyph="&#xE72E;" FontSize="11" Margin="12,0,8,0" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <PasswordBox x:Name="MasterBox" Grid.Column="1" Style="{StaticResource VaultFieldStyle}"
                                                 PlaceholderText="输入主密码，Enter 继续" MaxLength="128"
                                                 AutomationProperties.Name="主密码"
                                                 KeyDown="OnMasterKeyDown" PasswordChanged="OnMasterPasswordChanged"
                                                 GotFocus="OnFieldFocus" LostFocus="OnFieldFocus"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CapsHint" Visibility="Collapsed" Margin="2,-5,0,0" FontSize="10.5"
                                       Foreground="{ThemeResource VaultWarnFgBrush}" Text="大写锁定已开启"/>

                            <!-- 创建态：强度 + 要求清单 + 二次确认 -->
                            <StackPanel x:Name="StrengthPanel" Spacing="7" Visibility="Collapsed">
                                <StackPanel Spacing="5">
                                    <ProgressBar x:Name="StrengthBar" Maximum="100" Value="0" Height="4" CornerRadius="2"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="StrengthText" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="StrengthLabel" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ReqLength" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="ReqMixed" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="ConfirmFieldShell" Height="38" CornerRadius="9" Visibility="Collapsed"
                                    Background="{ThemeResource HistFieldFillBrush}"
                                    BorderBrush="{ThemeResource HistFieldStrokeBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Margin="12,0,8,0" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <PasswordBox x:Name="ConfirmBox" Grid.Column="1" Style="{StaticResource VaultFieldStyle}"
                                                 PlaceholderText="再输入一次主密码" MaxLength="128"
                                                 AutomationProperties.Name="确认主密码"
                                                 KeyDown="OnMasterKeyDown" PasswordChanged="OnConfirmPasswordChanged"
                                                 GotFocus="OnFieldFocus" LostFocus="OnFieldFocus"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="MatchHint" FontSize="11.5" Margin="2,-5,0,0" Visibility="Collapsed"/>

                            <!-- 硬错误（红条）与软提示（灰字）分开：取消 Hello 不是错误 -->
                            <!-- 解锁失败是三层：标题 / 正文 / 辅助，外加恢复入口（认证失败时不进阻断态，仍可改密码重试） -->
                            <Border x:Name="UnlockError" Visibility="Collapsed" CornerRadius="9" Padding="10,8"
                                    Background="{ThemeResource VaultErrorFillBrush}"
                                    BorderBrush="{ThemeResource VaultErrorStrokeBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <FontIcon Glyph="&#xEA39;" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Top"
                                              Foreground="{ThemeResource VaultErrorFgBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="UnlockErrorTitle" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource VaultErrorFgBrush}"/>
                                        <TextBlock x:Name="UnlockErrorText" FontSize="11.5" LineHeight="16"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource VaultErrorFgBrush}"/>
                                        <TextBlock x:Name="UnlockErrorHint" Visibility="Collapsed" FontSize="11"
                                                   LineHeight="16" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button x:Name="UnlockRecoverButton" Visibility="Collapsed" Margin="0,4,0,0"
                                                FontSize="11.5" Content="用备份文件恢复" Click="OnRecoverFromBackup"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="UnlockNotice" Visibility="Collapsed" Margin="2,-5,0,0"
                                       FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Button x:Name="UnlockButton" HorizontalAlignment="Stretch" Height="38" CornerRadius="9"
                                    FontSize="12.5" Click="OnUnlockClick" Style="{StaticResource AccentButtonStyle}"/>

                            <TextBlock x:Name="HelloHint" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                       Margin="2,-4,0,0"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="9.5" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="Argon2id + AES-256-GCM 整库加密 · 数据仅存本机" FontSize="10.5"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 密码库主视图（解锁态显示） ============ -->
        <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed" RowDefinitions="Auto,Auto,*,Auto">

            <!-- ① 搜索胶囊（与剪贴板历史同构：图标 + 输入 + 清除，聚焦光圈）+ 主操作「新建」 -->
            <Grid Grid.Row="0" Padding="14,10,14,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border x:Name="SearchShell" Height="34" CornerRadius="10"
                        Background="{ThemeResource HistFieldFillBrush}"
                        BorderBrush="{ThemeResource HistFieldStrokeBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Margin="11,0,0,0"
                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource VaultSearchBoxStyle}"
                                 PlaceholderText="搜索标题、用户名、网址或标签"
                                 TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
                                 GotFocus="OnSearchFocus" LostFocus="OnSearchFocusOut"
                                 AutomationProperties.Name="搜索密码条目"/>
                        <Button x:Name="SearchClearButton" Grid.Column="2" Click="OnClearSearch"
                                Style="{StaticResource VaultClearButtonStyle}" Visibility="Collapsed"
                                ToolTipService.ToolTip="清除搜索（Esc）"
                                AutomationProperties.Name="清除搜索">
                            <FontIcon Glyph="&#xE711;" FontSize="8.5"/>
                        </Button>
                    </Grid>
                </Border>
                <Border x:Name="SearchFocusRing" Grid.Column="0" CornerRadius="10" BorderThickness="1" Opacity="0"
                        IsHitTestVisible="False" BorderBrush="{ThemeResource HistFocusRingBrush}"/>

                <Button x:Name="NewButton" Grid.Column="1" Height="34" CornerRadius="8" FontSize="12.5"
                        Style="{StaticResource AccentButtonStyle}" Click="OnNewEntry"
                        ToolTipService.ToolTip="新建条目（Ctrl+N）">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="11.5"/>
                        <TextBlock Text="新建" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ② 等宽分段筛选（滑块弹簧平移）+ 右侧工具组 -->
            <Grid Grid.Row="1" Margin="14,0,14,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Grid x:Name="FilterStrip" Grid.Column="0" Height="34" CornerRadius="9"
                      Background="{ThemeResource HistSegmentTrackBrush}">
                    <Border x:Name="SegThumb" Height="28" Width="76" CornerRadius="7" Margin="3,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                            Background="{ThemeResource HistSegmentThumbBrush}"
                            BorderBrush="{ThemeResource HistRowStrokeBrush}" BorderThickness="1">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="SegThumbTr"/>
                        </Border.RenderTransform>
                    </Border>
                    <Grid ColumnDefinitions="76,76,76,76" Margin="3,0">
                        <Button x:Name="FilterAllButton" Style="{StaticResource VaultSegmentStyle}"
                                Click="OnFilterClick" Tag="All">
                            <TextBlock Text="全部" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, ElementName=FilterAllButton}"
                                       FontWeight="{Binding FontWeight, ElementName=FilterAllButton}"/>
                        </Button>
                        <Button x:Name="FilterLoginButton" Grid.Column="1" Style="{StaticResource VaultSegmentStyle}"
                                Click="OnFilterClick" Tag="Login">
                            <TextBlock Text="登录" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, ElementName=FilterLoginButton}"
                                       FontWeight="{Binding FontWeight, ElementName=FilterLoginButton}"/>
                        </Button>
                        <Button x:Name="FilterNoteButton" Grid.Column="2" Style="{StaticResource VaultSegmentStyle}"
                                Click="OnFilterClick" Tag="Note">
                            <TextBlock Text="笔记" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, ElementName=FilterNoteButton}"
                                       FontWeight="{Binding FontWeight, ElementName=FilterNoteButton}"/>
                        </Button>
                        <Button x:Name="FilterTotpButton" Grid.Column="3" Style="{StaticResource VaultSegmentStyle}"
                                Click="OnFilterClick" Tag="Totp">
                            <TextBlock Text="验证码" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, ElementName=FilterTotpButton}"
                                       FontWeight="{Binding FontWeight, ElementName=FilterTotpButton}"/>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button x:Name="GenButton" Height="34" CornerRadius="8" FontSize="12.5"
                            Style="{StaticResource QuietButtonStyle}" Click="OnToggleGenerator"
                            ToolTipService.ToolTip="随机密码 / 密码短语生成器">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9D9;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="生成器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <DropDownButton x:Name="MoreButton" Height="34" Width="34" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="8" ToolTipService.ToolTip="导入 / 备份 / 主密码"
                                    AutomationProperties.Name="更多操作">
                        <FontIcon Glyph="&#xE712;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="导入 CSV…" Click="OnImportCsv"/>
                                <MenuFlyoutItem Text="从加密备份恢复…" Click="OnRestoreBackup"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="加密备份…" Click="OnBackupVault"/>
                                <MenuFlyoutItem Text="明文导出 CSV…（危险）" Click="OnExportCsv"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="密码体检…" Click="OnOpenHealth"/>
                                <MenuFlyoutItem Text="回收站…" Click="OnOpenRecycleBin"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="修改主密码…" Click="OnChangeMasterPassword"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="LockButton" Height="34" CornerRadius="8" FontSize="12.5"
                            Style="{StaticResource QuietButtonStyle}" Click="OnLockClick"
                            ToolTipService.ToolTip="立即锁定并清除界面明文">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72E;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="锁定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <DropDownButton x:Name="SortButton" Height="34" CornerRadius="8"
                                    Background="Transparent" BorderThickness="0" Padding="8,0"
                                    ToolTipService.ToolTip="排序方式">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8CB;" FontSize="11"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="SortLabel" Text="最近修改" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="SortByUpdated" Text="最近修改" GroupName="VaultSort"
                                                     IsChecked="True" Click="OnSortByUpdated"/>
                                <RadioMenuFlyoutItem x:Name="SortByTitle" Text="标题 A → Z" GroupName="VaultSort"
                                                     Click="OnSortByTitle"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>

            <!-- ③ 列表 + 详情 -->
            <Grid x:Name="ContentGrid" Grid.Row="2" Margin="14,10,14,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <!-- 空库时没有可浏览的东西：列表列宽收到 0，把整幅宽度让给编辑器 -->
                    <ColumnDefinition x:Name="ListColumn" Width="272"/>
                    <!-- 详情列不设上限，改用 DetailRoot 的 640 + 居中收口（同 SettingsWindow 的内容列）：
                         空库折叠列表时表单仍居中，不会贴着左边留一大片空白 -->
                    <ColumnDefinition x:Name="DetailColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ListCard" Grid.Column="0" Style="{StaticResource VaultCardStyle}">
                    <Grid>
                        <ListView x:Name="EntryList" Background="Transparent" Padding="4,6,4,6"
                                  SelectionMode="Single" SelectionChanged="OnEntrySelected"
                                  ItemContainerStyle="{StaticResource HistoryItemStyle}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:VaultRow">
                                    <Grid Padding="9,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{x:Bind AvatarBrush}">
                                            <TextBlock Text="{x:Bind Initial}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{x:Bind AvatarFgBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE823;" FontSize="10.5"
                                                      Visibility="{x:Bind TotpBadgeVisibility}"
                                                      Foreground="{StaticResource SnapFlowAccentBrush}"
                                                      ToolTipService.ToolTip="含动态验证码"/>
                                            <FontIcon Glyph="&#xE8A5;" FontSize="10.5"
                                                      Visibility="{x:Bind NoteBadgeVisibility}"
                                                      Foreground="{ThemeResource VaultFaintGlyphBrush}"
                                                      ToolTipService.ToolTip="安全笔记"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 筛选 / 搜索无结果：就地提示并给出退路（空库时换成引导文案） -->
                        <StackPanel x:Name="ListEmptyPanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="8" Margin="18">
                            <FontIcon x:Name="ListEmptyIcon" Glyph="&#xE721;" FontSize="17"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ListEmptyTitle" Text="没有匹配的条目" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ListEmptyHint" Text="换个关键词，或切换上方的筛选。" FontSize="11" LineHeight="16"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="190"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <Button x:Name="ListEmptyClearButton" Content="清除筛选" Margin="0,4,0,0" Height="28"
                                    Padding="12,0" FontSize="11.5" CornerRadius="7" Click="OnClearFilters"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 详情列：编辑器 / 生成器共存，未选中时给引导占位 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 表单绝不横向滚动：一旦允许，聚焦某个输入框就可能把整列推偏，右侧被窗口裁掉 -->
                    <ScrollViewer x:Name="DetailPane" Grid.Row="0" Visibility="Collapsed" Padding="0,0,2,4"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <!-- Stretch + MaxWidth 才会「撑满到 640 再居中」；用 Center 会退化成按内容自适应宽度 -->
                        <StackPanel x:Name="DetailRoot" Spacing="10" Margin="0,0,0,12"
                                    MaxWidth="640" HorizontalAlignment="Stretch">
                            <!-- 生成器面板 -->
                            <Border x:Name="GeneratorPanel" Style="{StaticResource VaultCardStyle}"
                                    Padding="14,12" Visibility="Collapsed">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE92E;" FontSize="12"
                                                      Foreground="{StaticResource SnapFlowAccentBrush}"/>
                                            <TextBlock Text="密码生成器" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="收起" Height="26" Padding="9,0"
                                                FontSize="11.5" CornerRadius="6"
                                                Style="{StaticResource QuietButtonStyle}" Click="OnToggleGenerator"/>
                                    </Grid>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="GenLengthBox" Header="长度" Value="16" Width="88"
                                                   Minimum="6" Maximum="128" SmallChange="1" LargeChange="4"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnGeneratorLengthChanged"/>
                                        <NumberBox x:Name="GenWordsBox" Grid.Column="1" Header="词数" Value="6" Width="88"
                                                   Minimum="3" Maximum="12" SmallChange="1" Visibility="Collapsed"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnGeneratorLengthChanged"/>
                                        <CheckBox x:Name="GenPassphrase" Grid.Column="2" Content="使用密码短语"
                                                  FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                  Margin="10,0,0,0"
                                                  Checked="OnGeneratorOptionChanged" Unchecked="OnGeneratorOptionChanged"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <CheckBox x:Name="GenLower" Content="小写" FontSize="12" IsChecked="True"
                                                  Checked="OnGeneratorOptionChanged" Unchecked="OnGeneratorOptionChanged"/>
                                        <CheckBox x:Name="GenUpper" Content="大写" FontSize="12" IsChecked="True"
                                                  Checked="OnGeneratorOptionChanged" Unchecked="OnGeneratorOptionChanged"/>
                                        <CheckBox x:Name="GenDigits" Content="数字" FontSize="12" IsChecked="True"
                                                  Checked="OnGeneratorOptionChanged" Unchecked="OnGeneratorOptionChanged"/>
                                        <CheckBox x:Name="GenSymbols" Content="符号" FontSize="12" IsChecked="True"
                                                  Checked="OnGeneratorOptionChanged" Unchecked="OnGeneratorOptionChanged"/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GenOutput" IsReadOnly="True" FontFamily="Consolas"
                                                 VerticalAlignment="Center" FontSize="12.5"/>
                                        <Button Grid.Column="1" Content="复制" Height="30" Padding="10,0" FontSize="12"
                                                CornerRadius="7" Click="OnCopyGenerated"/>
                                        <Button Grid.Column="2" Content="重新生成" Height="30" Padding="10,0" FontSize="12"
                                                CornerRadius="7" Click="OnGeneratePassword"/>
                                        <Button Grid.Column="3" Content="使用" Height="30" Padding="12,0" FontSize="12"
                                                CornerRadius="7" Style="{StaticResource AccentButtonStyle}"
                                                Click="OnUseGenerated"/>
                                    </Grid>
                                    <TextBlock x:Name="GenEntropyText" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 编辑器：设置中枢式分组卡片（基础信息 / 登录凭据 / 附加信息） -->
                            <StackPanel x:Name="EditorRoot" Spacing="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                                            Background="{ThemeResource HistBadgeFillBrush}">
                                        <TextBlock x:Name="DetailInitial" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SnapFlowAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock x:Name="DetailHeader" Text="条目详情" FontSize="14"
                                                       FontWeight="SemiBold" CharacterSpacing="-12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border x:Name="UnsavedBadge" CornerRadius="7" Padding="6,1"
                                                    VerticalAlignment="Center" Visibility="Collapsed"
                                                    Background="{ThemeResource VaultBadgeFillBrush}">
                                                <TextBlock Text="未保存" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource VaultBadgeFgBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="DetailMeta" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="DeleteButton" Click="OnDeleteEntry"
                                            Style="{StaticResource VaultIconButtonStyle}"
                                            Foreground="{StaticResource SnapFlowDangerBrush}"
                                            ToolTipService.ToolTip="删除条目（Delete）"
                                            AutomationProperties.Name="删除条目">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    </Button>
                                </Grid>

                                <!-- 分组标题与卡片绑成一组：组内 6px 紧凑，组间由 EditorRoot 的 14px 分隔 -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="基础信息" Style="{StaticResource VaultGroupLabelStyle}"/>
                                    <Border Style="{StaticResource VaultCardStyle}" Padding="14,12">
                                        <!-- 类型与标题同排：类型是二选一的小开关，不该独占一整行高度 -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="KindCombo" Header="类型" SelectedIndex="0"
                                                      FontSize="12.5" MinWidth="0" HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnKindChanged">
                                                <ComboBoxItem Content="登录"/>
                                                <ComboBoxItem Content="安全笔记"/>
                                            </ComboBox>
                                            <TextBox x:Name="TitleBox" Grid.Column="1" Header="标题"
                                                     PlaceholderText="例如 GitHub"
                                                     FontSize="12.5" TextChanged="OnEditorDirty"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="CredentialFields" Spacing="6">
                                    <TextBlock Text="登录凭据" Style="{StaticResource VaultGroupLabelStyle}"/>
                                    <Border Style="{StaticResource VaultCardStyle}" Padding="14,12">
                                        <StackPanel Spacing="10">
                                            <TextBox x:Name="UsernameBox" Header="用户名 / 邮箱" FontSize="12.5"
                                                     TextChanged="OnEditorDirty"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="PasswordBox" Header="密码"
                                                             PasswordChanged="OnEditorDirty"/>
                                                <Button x:Name="RevealButton" Grid.Column="1" Content="显示"
                                                        Height="32" Padding="12,0" FontSize="12.5" MinWidth="0"
                                                        VerticalAlignment="Bottom" CornerRadius="7"
                                                        Click="OnToggleReveal"/>
                                            </Grid>
                                            <TextBox x:Name="PasswordTextBox" Header="密码" FontFamily="Consolas"
                                                     Visibility="Collapsed" TextChanged="OnEditorDirty"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="UrlBox" Header="网址" PlaceholderText="https://"
                                                         FontSize="12.5" TextChanged="OnEditorDirty"/>
                                                <Button Grid.Column="1" Content="打开" Height="32" Padding="12,0"
                                                        FontSize="12.5" MinWidth="0" VerticalAlignment="Bottom"
                                                        CornerRadius="7" Click="OnOpenUrl"
                                                        ToolTipService.ToolTip="在默认浏览器中打开"/>
                                            </Grid>
                                            <TextBox x:Name="TotpBox" Header="TOTP 密钥"
                                                     PlaceholderText="Base32 或 otpauth:// 链接，可选，用于生成动态验证码"
                                                     FontSize="12.5" TextChanged="OnEditorDirty"/>
                                            <Grid ColumnSpacing="8" x:Name="TotpDisplayRow" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{ThemeResource SetNoteFillBrush}" CornerRadius="8"
                                                        Padding="12,7">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Name="TotpCode" Text="------" FontSize="22"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                        <ProgressBar x:Name="TotpRing" Maximum="30" Value="30"
                                                                     Height="3" CornerRadius="1.5"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="1" Content="复制验证码" Height="32" Padding="12,0"
                                                        FontSize="12" MinWidth="0" VerticalAlignment="Center"
                                                        CornerRadius="7" Margin="8,0,0,0" Click="OnCopyTotp"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="附加信息" Style="{StaticResource VaultGroupLabelStyle}"/>
                                    <Border Style="{StaticResource VaultCardStyle}" Padding="14,12">
                                        <StackPanel Spacing="10">
                                            <TextBox x:Name="TagsBox" Header="标签（逗号分隔）"
                                                     PlaceholderText="例如 工作, 财务" FontSize="12.5"
                                                     TextChanged="OnEditorDirty"/>
                                            <TextBox x:Name="NotesBox" Header="备注" AcceptsReturn="True" MinHeight="68"
                                                     TextWrapping="Wrap" FontSize="12.5" TextChanged="OnEditorDirty"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        操作条钉在滚动区外面：窗口只有 660 高，表单再长也不能把「保存」滚出视野。
                        顶部一条发丝线把它和表单分开，滚动时内容从线下面穿过。
                    -->
                    <Border x:Name="EditorActionBar" Grid.Row="1" Visibility="Collapsed"
                            Padding="0,10,0,0" Margin="0,6,0,0" MaxWidth="640"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{ThemeResource SetCardStrokeBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="保存" Height="32" CornerRadius="8" MinWidth="84" FontSize="12.5"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnSaveEntry"
                                    ToolTipService.ToolTip="保存（Ctrl+S）"/>
                            <Button x:Name="CopyPasswordButton" Grid.Column="1" Content="复制密码" Height="32"
                                    CornerRadius="8" Padding="12,0" FontSize="12" Click="OnCopyPassword"/>
                            <Button x:Name="CopyUsernameButton" Grid.Column="2" Content="复制用户名" Height="32"
                                    CornerRadius="8" Padding="12,0" FontSize="12" Click="OnCopyUsername"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource HotkeyKeycapStyle}" Padding="7,1">
                                    <TextBlock Text="Ctrl S" FontSize="9.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Border>
                                <TextBlock Text="保存" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 未选中条目时的引导占位，避免右侧大片留白 -->
                    <StackPanel x:Name="DetailPlaceholder" Grid.RowSpan="2" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="56" Height="56" CornerRadius="18" HorizontalAlignment="Center"
                                Background="{ThemeResource HistBadgeFillBrush}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="20"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="选择左侧条目查看详情" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="或按 Ctrl + N 新建一条。" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 空库欢迎态：铺满内容区，替换列表与详情 -->
                <StackPanel x:Name="EmptyPane" Grid.ColumnSpan="2" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                            MaxWidth="360">
                    <Border Width="72" Height="72" CornerRadius="24" HorizontalAlignment="Center"
                            Background="{ThemeResource HistBadgeFillBrush}">
                        <FontIcon Glyph="&#xE72E;" FontSize="28" Foreground="{StaticResource SnapFlowAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="EmptyTitle" Text="还没有条目" FontSize="13.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="EmptyHint" FontSize="11.5" LineHeight="17"
                                   MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="EmptyCreateButton" Content="创建第一个条目" Height="32" Padding="14,0"
                                FontSize="12.5" CornerRadius="8"
                                Style="{StaticResource AccentButtonStyle}" Click="OnNewEntry"/>
                        <Button x:Name="EmptyImportButton" Height="32" Padding="12,0" FontSize="12.5"
                                CornerRadius="8" Click="OnImportCsv">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="11.5"/>
                                <TextBlock Text="从 CSV 导入" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="EmptyHotkeyHint" Text="Alt + P 可随时唤出密码库" FontSize="10.5"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ④ 底部快捷键提示（同 HistoryWindow 的收口条） -->
            <TextBlock Grid.Row="3" Height="24" Margin="14,0,14,4" FontSize="10.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Ctrl+N 新建    Ctrl+F 搜索    Ctrl+S 保存    Del 删除"/>
        </Grid>
    </Grid>
</Window>
