<Window
    x:Class="Jietu.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jietu"
    Title="SnapFlow 设置">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <!-- 品牌色一致性：开关与强调按钮沿用 SnapFlow 极光蓝，而不是系统强调色 -->
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#402D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A6FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#332D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#332D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
                        <!-- 行图标语义色：暗色主题整体提亮一档，保证在小尺寸釉块上的对比度 -->
                        <SolidColorBrush x:Key="RowGlyphBlueBrush" Color="#6E97FF"/>
                        <SolidColorBrush x:Key="RowGlyphGreenBrush" Color="#4ADE80"/>
                        <SolidColorBrush x:Key="RowGlyphAmberBrush" Color="#FBBF24"/>
                        <SolidColorBrush x:Key="RowGlyphPurpleBrush" Color="#B39DF8"/>
                        <SolidColorBrush x:Key="RowGlyphTealBrush" Color="#2DD4BF"/>
                        <SolidColorBrush x:Key="RowGlyphRedBrush" Color="#F87171"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <!-- 品牌色一致性：开关与强调按钮沿用 SnapFlow 极光蓝，而不是系统强调色 -->
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#402D6EFA"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A6FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#332D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#3D7BFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1E5FE6"/>
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#332D6EFA"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="RowGlyphBlueBrush" Color="#2D6EFA"/>
                        <SolidColorBrush x:Key="RowGlyphGreenBrush" Color="#0E9F6E"/>
                        <SolidColorBrush x:Key="RowGlyphAmberBrush" Color="#D97706"/>
                        <SolidColorBrush x:Key="RowGlyphPurpleBrush" Color="#7C4DEF"/>
                        <SolidColorBrush x:Key="RowGlyphTealBrush" Color="#0D9488"/>
                        <SolidColorBrush x:Key="RowGlyphRedBrush" Color="#DC2626"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <!-- 分组小标题：Apple「System Settings」式的弱化标签 -->
                <Style x:Key="SettingsGroupLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="CharacterSpacing" Value="20"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Setter Property="Margin" Value="3,0,0,1"/>
                </Style>

                <!-- 内嵌分组卡片：12 圆角 + 发丝描边 -->
                <Style x:Key="SettingsCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource SetCardFillBrush}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource SetCardStrokeBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>

                <!-- 行内条目：左图标釉块 + 标题/说明 + 右侧控件 -->
                <Style x:Key="SettingsRowIconStyle" TargetType="Border">
                    <Setter Property="Width" Value="26"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="CornerRadius" Value="7"/>
                    <Setter Property="Background" Value="{ThemeResource SetIconTileFillBrush}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

                <!-- 行图标釉块按语义着色：与侧栏彩釉同源的极淡染色，macOS 系统设置式 -->
                <Style x:Key="RowTileBlueStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1F2D6EFA"/>
                </Style>
                <Style x:Key="RowTileGreenStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1F10B981"/>
                </Style>
                <Style x:Key="RowTileAmberStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1FF59E0B"/>
                </Style>
                <Style x:Key="RowTilePurpleStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1F8B5CF6"/>
                </Style>
                <Style x:Key="RowTileTealStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1F14B8A6"/>
                </Style>
                <Style x:Key="RowTileRedStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowIconStyle}">
                    <Setter Property="Background" Value="#1FEF4444"/>
                </Style>

                <!-- 卡片内分隔线：与文字左缘对齐（14 + 26 + 12） -->
                <Style x:Key="SettingsDividerStyle" TargetType="Rectangle">
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="52,0,14,0"/>
                    <Setter Property="Fill" Value="{ThemeResource SetCardStrokeBrush}"/>
                </Style>

                <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>

                <Style x:Key="SettingsRowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldHintStyle}">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="LineHeight" Value="16"/>
                </Style>

                <!-- 底部说明条：细描边 + 极淡填充 -->
                <Style x:Key="SettingsNoteStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource SetNoteFillBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="Padding" Value="12,10"/>
                </Style>

                <!-- 侧栏图标釉块 -->
                <Style x:Key="NavTileStyle" TargetType="Border">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

                <Style x:Key="NavLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>


            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ① 一体化标题栏：左侧延续侧栏材质，右侧为当前设置分区标题（整条可拖拽） -->
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource SetPaneFillBrush}"/>
            <Border Grid.Column="1" Background="{ThemeResource SetContentFillBrush}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5B9BFF" Offset="0"/>
                            <GradientStop Color="#7341F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE7EE;" FontSize="9" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SnapFlow" FontSize="12" FontWeight="SemiBold" CharacterSpacing="24"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="SectionTitleHost" Grid.Column="1" Margin="26,0,150,0"
                        VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="SectionTitleBlock" Text="快捷按键" FontSize="15" FontWeight="SemiBold"
                           CharacterSpacing="-10" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SectionSubtitleBlock" Text="全局呼出与操作手势" FontSize="11" Margin="0,-1,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- 内容区底色 -->
        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SetContentFillBrush}"/>

        <!-- 侧栏底层材质：即使导航控件本身不绘制背景，也保持半透明玻璃层 -->
        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SetPaneFillBrush}"/>

        <!-- ② 经典侧栏（NavigationView Left）：半透明材质 + 胶囊选中 -->
        <NavigationView Grid.Row="1" Grid.ColumnSpan="2" x:Name="SettingsNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="208"
                        CompactPaneLength="48"
                        Background="Transparent"
                        SelectionChanged="OnNavSelectionChanged">

            <!-- 覆写 NavigationView 自带视觉：去掉 Windows 强调色竖条，换成 Apple 式柔和胶囊 -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14FFFFFF"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1FFFFFFF"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#3A2D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3D2D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#472D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#9FC0FF"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#B5CFFF"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#8FB6FF"/>
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#1AFFFFFF"/>
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0B000000"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#14000000"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2B2D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2E2D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#382D6EFA"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1B54D0"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#1B54D0"/>
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#16409E"/>
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#14000000"/>
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHotkeys" Tag="Hotkeys" AutomationProperties.Name="快捷按键">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#63A4FF" Offset="0"/>
                                        <GradientStop Color="#2D6EFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE765;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="快捷按键" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavGeneral" Tag="General" AutomationProperties.Name="常规与自启">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8E84FA" Offset="0"/>
                                        <GradientStop Color="#6D5BF3" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE770;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="常规与自启" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavClipboard" Tag="Clipboard" AutomationProperties.Name="剪贴板历史">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFC05C" Offset="0"/>
                                        <GradientStop Color="#F59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="剪贴板历史" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavOsd" Tag="Osd" AutomationProperties.Name="性能监视器">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4ADE80" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE9D9;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="性能监视器" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAi" Tag="Ai" AutomationProperties.Name="AI 视觉配置">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C084FC" Offset="0"/>
                                        <GradientStop Color="#9333EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE946;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AI 视觉配置" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem x:Name="NavVault" Tag="Vault" AutomationProperties.Name="密码库">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF8A8A" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="密码库" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAbout" Tag="About" AutomationProperties.Name="关于 SnapFlow">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavTileStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B4BDCB" Offset="0"/>
                                        <GradientStop Color="#8792A2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE897;" FontSize="10" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="关于 SnapFlow" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <TextBlock x:Name="SidebarVersionText" Text="v… · 设置中枢" FontSize="10.5" Margin="16,0,0,10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </NavigationView.PaneFooter>

            <!-- 主内容区：各模块独立自适应面板 -->
            <Grid Padding="26,4,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error"
                         CornerRadius="10" BorderThickness="1" Margin="0,0,0,12" Grid.Row="0"
                         MaxWidth="620" HorizontalAlignment="Center"/>

                <!-- 1. 快捷按键面板 -->
                <ScrollViewer x:Name="PanelHotkeys" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="全局快捷键" Style="{StaticResource SettingsGroupLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ResetHotkeysButton" Grid.Column="1" Content="恢复默认"
                                        Style="{StaticResource QuietButtonStyle}" FontSize="11.5" Padding="10,4"
                                        CornerRadius="7" Click="OnResetHotkeysClick"
                                        ToolTipService.ToolTip="恢复为 Alt+A（截图）/ Alt+V（历史与贴图）"/>
                            </Grid>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE7EE;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="区域截图" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="框选区域、单击选中窗口，或按 Enter 全屏截图"/>
                                        </StackPanel>
                                        <Button x:Name="RegionHotkeyBtn" Grid.Column="2" Style="{StaticResource HotkeyButtonStyle}"
                                                Click="OnRegionHotkeyClick" KeyDown="OnHotkeyDown" ToolTipService.ToolTip="点击后直接按下新快捷键">
                                            <StackPanel x:Name="RegionKeycapsHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileAmberStyle}">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource RowGlyphAmberBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="剪贴板历史 / 贴图" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="快速呼出历史记录与便签面板"/>
                                        </StackPanel>
                                        <Button x:Name="HistoryHotkeyBtn" Grid.Column="2" Style="{StaticResource HotkeyButtonStyle}"
                                                Click="OnHistoryHotkeyClick" KeyDown="OnHotkeyDown" ToolTipService.ToolTip="点击后直接按下新快捷键">
                                            <StackPanel x:Name="HistoryKeycapsHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsNoteStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource SnapFlowAccentBrush}"
                                          VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="录制提示" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                               Text="快捷键请包含 Alt、Ctrl 或 Win 修饰键；若与其他全局热键冲突将自动提示；录制过程中按 Esc 取消。"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. 常规与自启面板 -->
                <ScrollViewer x:Name="PanelGeneral" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="启动" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource RowTileGreenStyle}">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="12" Foreground="{ThemeResource RowGlyphGreenBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="开机自启" Style="{StaticResource SettingsRowTitleStyle}"/>
                                        <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                   Text="登录 Windows 后在后台托盘自动就绪"/>
                                    </StackPanel>
                                    <!-- MinWidth=0：抵消 WinUI 默认 154 最小宽 + 轨道贴左模板，让胶囊贴齐右缘 -->
                                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                  OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSettingToggled"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="截图与存储" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource RowTileBlueStyle}">
                                        <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="自动保存截图到本地" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="完成截图时除复制到剪贴板，自动保存一份 PNG 到指定目录；超期文件与历史记录使用相同的保留天数"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SaveSwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                      OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSaveToggled"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid x:Name="FolderRow" Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileAmberStyle}">
                                            <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource RowGlyphAmberBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="截图保存目录" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="截图 PNG 的存放位置，超期文件由保留天数统一清理"/>
                                            <TextBox x:Name="FolderBox" IsReadOnly="True" CornerRadius="7" FontSize="11.5" Padding="8,4"
                                                     Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button x:Name="OpenFolderButton" Style="{StaticResource QuietButtonStyle}" Padding="8,5"
                                                    Click="OnOpenFolder" ToolTipService.ToolTip="打开文件夹">
                                                <FontIcon Glyph="&#xE838;" FontSize="12"/>
                                            </Button>
                                            <Button x:Name="BrowseButton" Content="更改…" MinWidth="64" Click="OnBrowse"
                                                    CornerRadius="7" FontSize="12" Padding="10,5"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTilePurpleStyle}">
                                            <FontIcon Glyph="&#xE78B;" FontSize="12" Foreground="{ThemeResource RowGlyphPurpleBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="多显示器截屏范围" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="多屏环境下的框选覆盖策略"/>
                                        </StackPanel>
                                        <ComboBox x:Name="MultiMonitorModeBox" Grid.Column="2" MinWidth="158"
                                                  CornerRadius="7" FontSize="12" SelectionChanged="OnMultiMonitorModeChanged">
                                            <ComboBoxItem Content="智能自适应 (推荐)" Tag="Auto"/>
                                            <ComboBoxItem Content="跨屏全景拼接" Tag="AllMonitors"/>
                                            <ComboBoxItem Content="仅光标所在屏幕" Tag="ActiveMonitor"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. 剪贴板历史面板 -->
                <ScrollViewer x:Name="PanelClipboard" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="保留与范围" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="历史记录保留天数" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="超期后自动清理未固定的记录（已固定的永久保留）；自动保存的截图也按此天数清理"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <NumberBox x:Name="RetentionBox" Width="88" Minimum="1" Maximum="3650"
                                                       SmallChange="1" ValueChanged="OnRetentionChanged" SpinButtonPlacementMode="Compact"
                                                       VerticalAlignment="Center"
                                                       MinHeight="0" Padding="8,4,4,4" CornerRadius="7" FontSize="12"/>
                                            <TextBlock Text="天" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileTealStyle}">
                                            <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource RowGlyphTealBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="记录终端里的复制" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="PowerShell、CMD 及 Windows Terminal 中的文字默认过滤"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TerminalSwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                      OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSettingToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="隐私过滤" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Style="{StaticResource RowTileRedStyle}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource RowGlyphRedBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="9">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="排除不记录的程序" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="来自这些程序中的复制将完全被忽略，杜绝敏感记录泄露。"/>
                                        </StackPanel>

                                        <!-- 一键快速添加推荐胶囊（已在排除列表中时自动进入禁用态） -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="快捷添加" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <Button x:Name="WeChatQuickChip" Content="微信" Style="{StaticResource FilterChipStyle}" Click="OnQuickIgnoreClick" Tag="WeChat.exe"/>
                                            <Button x:Name="TerminalQuickChip" Content="Terminal" Style="{StaticResource FilterChipStyle}" Click="OnQuickIgnoreClick" Tag="WindowsTerminal.exe"/>
                                            <Button x:Name="OnePasswordQuickChip" Content="1Password" Style="{StaticResource FilterChipStyle}" Click="OnQuickIgnoreClick" Tag="1Password.exe"/>
                                        </StackPanel>

                                        <!-- 动态排除程序标签：自动换行，不再横向滚动 -->
                                        <local:WrapPanel x:Name="IgnoreChipsContainer" Visibility="Collapsed"/>

                                        <TextBlock x:Name="IgnoreEmptyHint" Style="{StaticResource SettingsRowHintStyle}"
                                                   Text="暂无排除项，来自所有程序的复制都会被记录"/>

                                        <!-- 输入框与添加按钮 -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="460" HorizontalAlignment="Left">
                                            <TextBox x:Name="NewIgnoreInput" PlaceholderText="输入程序名，例如 notepad.exe"
                                                     Height="32" Padding="8,4" FontSize="12" CornerRadius="7" KeyDown="OnNewIgnoreKeyDown"/>
                                            <Button Grid.Column="1" Content="添加" Height="32" Padding="14,4" Click="OnAddIgnoreClick"
                                                    CornerRadius="7" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsNoteStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SnapFlowAccentBrush}"
                                          VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="隐私保护" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                               TextWrapping="Wrap"
                                               Text="遵循剪贴板「请勿收录」标记（密码管理器行业标准），并内置密码管理器与系统密码框识别；尽力过滤，但不保证覆盖远程桌面、UAC、浏览器扩展等所有场景。"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. 性能监视器 (OSD) 面板 -->
                <ScrollViewer x:Name="PanelOsd" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="显示" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileGreenStyle}">
                                            <FontIcon Glyph="&#xE9D2;" FontSize="12" Foreground="{ThemeResource RowGlyphGreenBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="屏幕性能悬浮挂件" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="置顶监控 GPU 利用率/显存/温度、CPU、内存及网速"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="OsdSwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                      OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSettingToggled"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="停靠对齐方位" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="悬浮挂件在屏幕上的贴顶停靠角"/>
                                        </StackPanel>
                                        <ComboBox x:Name="OsdPositionBox" Grid.Column="2" MinWidth="130" CornerRadius="7"
                                                  FontSize="12" SelectionChanged="OnOsdPositionChanged">
                                            <ComboBoxItem Content="右上角" Tag="TopRight"/>
                                            <ComboBoxItem Content="左上角" Tag="TopLeft"/>
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileTealStyle}">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource RowGlyphTealBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="驻留显示器" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="选择悬浮挂件停靠的屏幕"/>
                                        </StackPanel>
                                        <ComboBox x:Name="OsdDisplayBox" Grid.Column="2" MinWidth="158" CornerRadius="7"
                                                  FontSize="12" SelectionChanged="OnOsdDisplayChanged">
                                            <ComboBoxItem Content="主显示器" Tag="Primary"/>
                                            <ComboBoxItem Content="跟随鼠标所在屏幕" Tag="FollowCursor"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="行为" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource RowTileAmberStyle}">
                                        <FontIcon Glyph="&#xE722;" FontSize="12" Foreground="{ThemeResource RowGlyphAmberBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="截图时自动避让隐藏" Style="{StaticResource SettingsRowTitleStyle}"/>
                                        <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                   Text="进入截图遮罩时自动退出视野，避免被截入画面"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OsdHideOnCaptureSwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                  OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSettingToggled"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- OSD 实时排版动态仿真微视窗 -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="仿真预览" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="14,12">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="{ThemeResource SnapFlowAccentBrush}"/>
                                        <TextBlock Text="屏幕顶部悬浮效果" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- 模拟桌面顶边：里面的挂件由真实 OSD 渲染器实时出图，不再手写假控件 -->
                                    <Border x:Name="OsdPreviewStage"
                                            BorderBrush="{ThemeResource SetCardStrokeBrush}"
                                            BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Height="62">
                                        <!-- 壁纸感渐变：晨空蓝到深靛，让纯黑胶囊的轮廓与投影能读出来（同色底会让它糊成一片） -->
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7FA8DE" Offset="0"/>
                                                <GradientStop Color="#4A6AA6" Offset="0.45"/>
                                                <GradientStop Color="#22335C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid x:Name="OsdPreviewHost" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                  Margin="26,0,6,0">
                                                <Image x:Name="OsdPreviewImage" Stretch="Uniform"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="OsdPreviewHint" Style="{StaticResource SettingsRowHintStyle}"
                                               TextWrapping="Wrap"
                                               Text="预览由桌面悬浮窗的真实渲染器生成，数值与实机同步"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. AI 视觉配置面板 -->
                <ScrollViewer x:Name="PanelAi" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="模型接入" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="API 端点 (Base URL)" Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock x:Name="AiUrlBadge" FontSize="10.5" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="兼容 OpenAI / DeepSeek / Ollama 协议"/>
                                        </StackPanel>
                                        <TextBox x:Name="AiUrlBox" Grid.Column="2" Width="226" CornerRadius="7" FontSize="12"
                                                 PlaceholderText="https://api.openai.com/v1" TextChanged="OnAiSettingChanged"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileAmberStyle}">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="12" Foreground="{ThemeResource RowGlyphAmberBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="API 密钥 (API Key)" Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock x:Name="AiKeyBadge" FontSize="10.5" VerticalAlignment="Center"
                                                           Text="未配置" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="本机加密存储 · Windows DPAPI"/>
                                        </StackPanel>
                                        <PasswordBox x:Name="AiKeyBox" Grid.Column="2" Width="226" CornerRadius="7" FontSize="12"
                                                     PlaceholderText="sk-..." PasswordChanged="OnAiSettingChanged"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTilePurpleStyle}">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource RowGlyphPurpleBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="模型名称 (Model)" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="支持视觉能力的多模态模型"/>
                                        </StackPanel>
                                        <TextBox x:Name="AiModelBox" Grid.Column="2" Width="226" CornerRadius="7" FontSize="12"
                                                 PlaceholderText="gpt-4o-mini" TextChanged="OnAiSettingChanged"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileTealStyle}">
                                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource RowGlyphTealBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="省流模式 (detail=low)" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="低分辨率视觉：显著降低 token 消耗，小字与细节识别率会下降"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AiEconomySwitch" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right"
                                                      OnContent="" OffContent="" VerticalAlignment="Center" Toggled="OnSettingToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="提示词" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Style="{StaticResource RowTileBlueStyle}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="默认视觉系统提示词" Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <HyperlinkButton x:Name="AiPromptResetButton" Content="恢复默认" Padding="0"
                                                                 Margin="0,-1,0,0" FontSize="11" VerticalAlignment="Center"
                                                                 Click="OnResetAiPrompt" ToolTipService.ToolTip="恢复出厂默认提示词"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="发送截图给模型时的默认指令"/>
                                        </StackPanel>
                                        <TextBox x:Name="AiPromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="72"
                                                 CornerRadius="7" FontSize="12" TextChanged="OnAiSettingChanged"
                                                 PlaceholderText="请分析并总结这张截图的内容..."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 一键握手连通性测试卡片 -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="连通性" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="接口可用性校验" FontSize="12.5" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <ProgressRing x:Name="AiTestProgress" IsActive="False" Width="13" Height="13" Visibility="Collapsed"/>
                                            <TextBlock x:Name="AiTestStatusText" FontSize="11.5" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="点击右侧测试当前 API 密钥与端点握手状态"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="AiTestButton" Grid.Column="1" Content="测试连接" Click="OnTestAiConnection"
                                            Style="{ThemeResource AccentButtonStyle}" CornerRadius="8" Padding="14,6" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. 密码库面板 -->
                <ScrollViewer x:Name="PanelVault" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="状态" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileRedStyle}">
                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource RowGlyphRedBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="本地密码库" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock x:Name="VaultStatusText" Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="未创建"/>
                                        </StackPanel>
                                        <Button x:Name="VaultOpenButton" Grid.Column="2" Content="打开密码库"
                                                CornerRadius="7" Click="OnOpenVault" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE192;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Windows Hello 快速解锁" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock x:Name="VaultHelloText" Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="解锁密码库后即可启用"/>
                                        </StackPanel>
                                        <Button x:Name="VaultHelloButton" Grid.Column="2" Content="启用"
                                                CornerRadius="7" Click="OnEnableHello" VerticalAlignment="Center" IsEnabled="False"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="安全" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileAmberStyle}">
                                            <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource RowGlyphAmberBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="空闲自动锁定" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="无操作超过该时长后锁定密码库；锁屏与睡眠总是立即锁定"/>
                                        </StackPanel>
                                        <ComboBox x:Name="VaultLockBox" Grid.Column="2" MinWidth="130" CornerRadius="7" FontSize="12"
                                                  SelectionChanged="OnVaultLockChanged">
                                            <ComboBoxItem Content="1 分钟" Tag="1"/>
                                            <ComboBoxItem Content="5 分钟" Tag="5"/>
                                            <ComboBoxItem Content="15 分钟" Tag="15"/>
                                            <ComboBoxItem Content="30 分钟" Tag="30"/>
                                            <ComboBoxItem Content="60 分钟" Tag="60"/>
                                            <ComboBoxItem Content="不自动锁定" Tag="0"/>
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <StackPanel Padding="14,12" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Style="{StaticResource RowTileGreenStyle}">
                                                <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource RowGlyphGreenBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="浏览器自动填充" Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock x:Name="VaultBrowserStatus" Style="{StaticResource SettingsRowHintStyle}"
                                                           Text="未启用"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="VaultExtIdBox" PlaceholderText="扩展 ID（chrome://extensions 中复制）"
                                                     Width="300" CornerRadius="7" FontSize="12"/>
                                            <Button x:Name="VaultBrowserEnableButton" Content="启用" Click="OnVaultBrowserEnable" CornerRadius="7"/>
                                            <Button x:Name="VaultBrowserDisableButton" Content="禁用" Click="OnVaultBrowserDisable" CornerRadius="7"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsRowHintStyle}" TextWrapping="Wrap"
                                                   Text="先在浏览器加载 ext/snapflow-vault 扩展，再把其 ID 填到这里。关联时桌面端会弹出确认。"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. 关于面板：内容块在可视区内垂直居中，避免大片留白 -->
                <ScrollViewer x:Name="PanelAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="7" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="18,20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="52" Height="52" CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#5B9BFF" Offset="0"/>
                                                <GradientStop Color="#7341F5" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE7EE;" FontSize="24" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="SnapFlow (瞬流)" FontSize="18" FontWeight="Bold" CharacterSpacing="-12"/>
                                        <TextBlock x:Name="AboutVersionText" Text="版本 …" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="轻量、现代且高效率的 Windows 智能截图、贴图、屏幕性能监控与剪贴板工作流增强工具。"
                                           Style="{StaticResource SettingsRowHintStyle}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock Text="文件位置" Style="{StaticResource SettingsGroupLabelStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileBlueStyle}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource RowGlyphBlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="截图目录" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="打开保存截图的文件夹"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="打开" Click="OnOpenFolder"
                                                Style="{StaticResource QuietButtonStyle}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource SettingsDividerStyle}"/>
                                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource RowTileTealStyle}">
                                            <FontIcon Glyph="&#xE838;" FontSize="12" Foreground="{ThemeResource RowGlyphTealBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="安装目录" Style="{StaticResource SettingsRowTitleStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsRowHintStyle}"
                                                       Text="定位 SnapFlow 的安装位置"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="打开" Click="OnOpenAppDir"
                                                Style="{StaticResource QuietButtonStyle}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsNoteStyle}" Margin="0,11,0,0">
                            <TextBlock Text="开源许可：SnapFlow 以 MIT License 分发，可自由使用、修改与再分发。"
                                       Style="{StaticResource SettingsRowHintStyle}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- 侧栏与内容区之间的发丝分界（贯穿到标题栏顶部） -->
        <Rectangle Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="207,0,0,0"
                   Fill="{ThemeResource SetPaneEdgeBrush}" IsHitTestVisible="False"/>
    </Grid>
</Window>
