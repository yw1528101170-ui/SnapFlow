%% SnapFlow Vault v2 —— 类图（从 02-design.md 抽出）
%% 说明：PasswordWindow 拆分为多个 partial 文件，图中以单个类表示，partial 归属见设计文档第 7 章。
%%       VaultCrypto / VaultStore / VaultFormat / VaultHealthService 均为 static（无实例状态）。

classDiagram
    direction LR

    class VaultHeader {
        <<readonly struct>>
        +int Version
        +uint KdfAlgorithm
        +uint AeadAlgorithm
        +int Iterations
        +int MemoryKiB
        +int Parallelism
        +uint Flags
        +uint CipherLength
        +byte-array Salt
        +byte-array Nonce
        +NewV2(int iter, int memKiB, int lanes) VaultHeader
        +WithFreshNonce() VaultHeader
        +ToBytes() byte-array
    }

    class VaultFormat {
        <<static>>
        +byte-array Magic
        +int HeaderLength
        +int CurrentFormatVersion
        +Classify(ReadOnlySpan raw) VaultFileKind
        +TryReadHeader(ReadOnlySpan raw, out VaultHeader h, out uint cipherLength) bool
        +BuildAad(VaultHeader h) byte-array
        +int AadLength
    }

    class VaultKdfPolicy {
        <<static 唯一参数来源>>
        +int Iterations
        +int MemoryKiB
        +int Parallelism
        +CreateHeader() VaultHeader
    }

    class VaultFileKind {
        <<enum>>
        Missing
        Unknown
        LegacyV1
        V2
        NewerVersion
        StructurallyInvalid
    }

    class VaultOpenStatus {
        <<enum>>
        Ok
        AuthenticationFailed
        StructureInvalid
        PayloadTooNew
        LegacyFormat
        NewerFormat
        UnknownFormat
        IoFailed
        Cancelled
    }

    class VaultKey {
        <<sealed IDisposable>>
        +int Length
        +bool IsDisposed
        +ReadOnlySpan Bytes
        +Clone() VaultKey
        +Dispose() void
    }

    class VaultCrypto {
        <<static>>
        +DeriveKey(ReadOnlySpan password, VaultHeader h) VaultKey
        +SealPayload(VaultHeader h, VaultKey key, ReadOnlySpan json) byte-array
        +Open(VaultHeader h, VaultKey key, ReadOnlySpan body) VaultOpenResult
        +ParsePayload(ReadOnlySpan json) VaultOpenResult
    }

    class VaultOpenResult {
        <<readonly record struct>>
        +VaultOpenStatus Status
        +VaultData Data
        +string Detail
        +bool Ok
    }

    class VaultStore {
        <<static>>
        +Read(string path) VaultFileRead
        +SaveAsync(string path, byte-array fileBytes, CancellationToken ct) Task
        +CleanupTemporaryFiles(string path) int
        +ListBackups(string path) string-list
        +TryCreateCorruptBackup(string path, VaultFileKind kind) string
        +LastNotice string
    }

    class VaultFileRead {
        <<readonly record struct>>
        +byte-array Raw
        +VaultFileKind Kind
        +VaultHeader Header
        +byte-array Body
    }

    class VaultBackupRotation {
        <<static>>
        +Rotate(string path, DateTimeOffset now) string
        +Prune(string path, int keep) int
        +SortKeyPattern string
    }

    class VaultSaveScheduler {
        <<sealed IDisposable>>
        +CaptureOnUi Func-VaultSnapshot
        +Persist Func-VaultSnapshot-Task
        +int DebounceMs
        +Request() void
        +FlushAsync(CancellationToken ct) Task-bool
        +StopAsync() Task
        +StateChanged Action
        +LastSavedUtc DateTimeOffset
    }

    class VaultSnapshot {
        <<sealed>>
        +VaultHeader Header
        +VaultData Data
        +long DataVersion
    }

    class VaultSession {
        <<sealed IDisposable>>
        +VaultState State
        +VaultBlockInfo Block
        +VaultData Data
        +bool IsUnlocked
        +bool Exists
        +long DataVersion
        +UnlockAsync(string pw, CancellationToken ct) Task-VaultUnlockResult
        +UnlockWithHelloAsync(CancellationToken ct) Task-VaultUnlockResult
        +CreateAsync(string pw, CancellationToken ct) Task-VaultUnlockResult
        +RequestSaveAsync() Task
        +FlushAsync() Task-bool
        +ChangeMasterPasswordAsync(string pw, IProgress progress, CancellationToken ct) Task-VaultChangeResult
        +QueryLoginsAsync(string token, string host, int limit, CancellationToken ct) Task-VaultBridgeLogin-array
        +GetHealthReportAsync(bool force, CancellationToken ct) Task-VaultHealthReport
        +MoveToRecycleBin(string entryId) void
        +RestoreFromRecycleBin(string entryId) bool
        +PurgeRecycleBinEntry(string entryId) void
        +SweepRecycleBin() int
        +HistoryOf(string entryId) VaultEntryVersion-list
        +RollbackToVersion(string entryId, int index) bool
        +MergeIncoming(IEnumerable incoming, out int skipped) int
        +AuditRecords() VaultAuditRecord-list
        +Unlocked Action
        +Locked Action
        +Lock() void
    }

    class VaultState {
        <<enum>>
        Missing
        Locked
        Unlocked
        Blocked
    }

    class VaultBlockInfo {
        <<record>>
        +VaultBlockKind Kind
        +string Path
        +long FileBytes
        +string Message
    }

    class VaultData {
        +int SchemaVersion
        +List~VaultEntry~ Entries
        +List~VaultEntry~ RecycleBin
        +List~VaultTrustedBrowser~ TrustedBrowsers
        +List~VaultHealthIgnore~ HealthIgnores
        +int ClipboardClearSeconds
        +CloneForBackground() VaultData
        +Normalize() void
    }

    class VaultEntry {
        +string Id
        +string Kind
        +string Title
        +string Username
        +string Password
        +string Url
        +string Notes
        +List~string~ Tags
        +string TotpSecret
        +DateTimeOffset CreatedUtc
        +DateTimeOffset UpdatedUtc
        +DateTimeOffset? DeletedUtc
        +bool? CriticalOverride
        +List~VaultEntryVersion~ History
        +ContentSnapshot() VaultEntryVersion
    }

    class VaultEntryVersion {
        <<record>>
        +DateTimeOffset ChangedUtc
        +List~string~ ChangedFields
        +string Title
        +string Username
        +string Password
        +string Url
        +string Notes
        +List~string~ Tags
        +string TotpSecret
    }

    class VaultHealthIgnore {
        <<record>>
        +string EntryId
        +string Dimension
        +string GroupKey
        +DateTimeOffset IgnoredUtc
    }

    class VaultCriticalDomains {
        <<static 关键词表>>
        +IsCritical(string host, bool? overrideFlag) bool
        +Keywords ReadOnlySpan
    }

    class VaultBridgeProtocol {
        <<static>>
        +UrlMatches(string entryUrl, string requestUrl) bool
        +MatchKind(string entryUrl, string requestUrl) MatchKind
        +HostOf(string url) string
    }

    class VaultSuffixPolicy {
        <<static 常量表>>
        +MultiLabelPublicSuffixes ReadOnlySpan
        +IsMultiLabelPublicSuffix(string host) bool
        +LabelCount(string host) int
    }

    class VaultHealthService {
        <<static>>
        +Compute(VaultData data, VaultHealthOptions opt, CancellationToken ct) VaultHealthReport
        +CacheKeyOf(VaultData data) long
    }

    class VaultHealthDimension {
        <<enum 5 维>>
        Weak
        Fragment
        Reused
        Stale
        MissingTwoFactor
    }

    class VaultHealthReport {
        <<record>>
        +DateTimeOffset ComputedUtc
        +long DataVersion
        +int TotalActionable
        +IReadOnlyList~VaultHealthIssue~ Issues
        +IReadOnlyList~VaultHealthGroup~ Groups
    }

    class VaultRecycleBinService {
        <<static>>
        +MoveToBin(VaultData data, string entryId, DateTimeOffset now) int
        +Restore(VaultData data, string entryId) bool
        +Purge(VaultData data, string entryId) bool
        +Clear(VaultData data) int
        +Sweep(VaultData data, DateTimeOffset now, int retainDays, int maxCount) int
    }

    class VaultHistoryService {
        <<static>>
        +Record(VaultEntry entry, VaultEntryVersion next, int keep) void
        +DiffFields(VaultEntryVersion a, VaultEntryVersion b) string-list
        +Rollback(VaultEntry entry, int index, int keep, DateTimeOffset now) bool
    }

    class VaultBridge {
        <<sealed IDisposable>>
        +Start() void
        +CompletePair(string pairId, bool accept) void
        +PairRequested Action
        +Dispose() void
    }

    class VaultPairingGate {
        <<sealed>>
        +TryBegin(PendingPair p) bool
        +Complete(string pairId, bool accept) bool
        +Current PendingPair
    }

    class VaultRateLimiter {
        <<sealed>>
        +int Capacity
        +TryAcquire(string clientId, out int retryAfterSeconds) bool
        +Reset() void
    }

    class VaultAuditLog {
        <<sealed>>
        +int Capacity
        +Record(string host, VaultAuditResult result, int count) void
        +Snapshot() VaultAuditRecord-list
        +Clear() void
    }

    class VaultImportExport {
        <<static>>
        +ParseCsv(string text) VaultCsvRow-list
        +ToEntries(IEnumerable rows) VaultEntry-list
        +MergeInto(VaultData target, IEnumerable incoming) int
        +BuildCsv(IEnumerable entries) string
        +BuildEncryptedBackup(VaultData data, string pw) byte-array
        +OpenEncryptedBackup(byte-array raw, string pw) VaultOpenResult
        +ValidateLimits(IEnumerable rows, out string error) bool
    }

    class PasswordGenerator {
        <<static>>
        +int WordListSize
        +int DefaultWords
        +Generate(int length, bool lower, bool upper, bool digits, bool symbols) string
        +GeneratePassphrase(int words, string separator) string
        +EstimatePassphraseEntropyBits(int words) double
        +EstimatePasswordEntropy(string password) tuple
    }

    class VaultMessages {
        <<static>>
        +BlockTitleLegacy string
        +BlockBodyLegacy(string path) string
        +BlockTitleIntegrity string
        +BlockBodyIntegrity(string path) string
        +BlockTitleNewer string
        +PassphraseEntropyLabel(int words, int bits) string
        +SaveFailedRolledBack string
        +TrashMovedToast string
        +RateLimited(string secs) string
    }

    class VaultLimits {
        <<static>>
        +int MaxImportEntries
        +int MaxFieldChars
        +int TrashRetainDays
        +int TrashMaxEntries
        +int HistoryVersions
        +int AuditCapacity
        +int RateLimitPerMinute
        +int RateLimitPauseSeconds
        +int RollingBackups
        +long MaxCorruptBackupBytes
        +int BridgeLoginLimit
        +int SaveDebounceMs
    }

    class PasswordWindow {
        <<sealed partial Window>>
        +Present() void
        +Dismiss() void
        -RefreshState() void
        -ShowBlockCard(VaultBlockInfo info) void
    }

    %% ---- 关系 ----
    VaultSession *-- VaultKey : 持有解锁密钥
    VaultSession *-- VaultHeader : 当前头
    VaultSession *-- VaultData : 解锁后的明文
    VaultSession *-- VaultSaveScheduler : 保存编排
    VaultSession ..> VaultStore : 读写文件
    VaultSession ..> VaultCrypto : 派生/加解密
    VaultSession ..> VaultFormat : 版本判定
    VaultSession ..> VaultRecycleBinService
    VaultSession ..> VaultHistoryService
    VaultSession ..> VaultHealthService
    VaultHealthService ..> VaultHealthDimension
    VaultHealthService ..> VaultCriticalDomains : 关键账号关键词
    VaultSession ..> VaultAuditLog
    VaultSession ..> HelloUnlock : 快速解锁
    VaultSession ..> VaultKdfPolicy : 新建库/改主密码取参数
    VaultKdfPolicy ..> VaultHeader : CreateHeader

    VaultSaveScheduler *-- VaultSnapshot : UI 线程克隆出的快照
    VaultSnapshot *-- VaultData : CloneForBackground 副本
    VaultSaveScheduler ..> VaultCrypto
    VaultSaveScheduler ..> VaultStore
    VaultStore *-- VaultBackupRotation

    VaultData *-- VaultEntry
    VaultData *-- VaultTrustedBrowser
    VaultData *-- VaultHealthIgnore
    VaultEntry *-- VaultEntryVersion : 最近 5 版

    VaultBridge ..> VaultBridgeProtocol : 匹配判定
    VaultBridgeProtocol ..> VaultSuffixPolicy : 公共后缀防护
    VaultBridge *-- VaultPairingGate : 配对原子化
    VaultBridge *-- VaultRateLimiter : 60 次/分钟
    VaultBridge ..> VaultAuditLog
    VaultBridge ..> VaultSession : QueryLoginsAsync

    VaultImportExport ..> VaultCrypto
    VaultImportExport ..> VaultFormat
    PasswordGenerator ..> VaultMessages : 显示真实熵值
    PasswordWindow ..> VaultSession
    PasswordWindow ..> VaultMessages
