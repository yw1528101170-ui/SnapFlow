<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jietu.AiVisionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI 视觉分析">
    <!-- 窗口根：底部是 Mica 玻璃，所有内容以「半透明层级」叠在其上 -->
    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- 输入框：彻底扁平化，外壳由 Composer 的玻璃胶囊承担 -->
                <Style x:Key="AiInputBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Grid Background="Transparent">
                                    <ScrollViewer x:Name="ContentElement"
                                                  Background="Transparent"
                                                  Padding="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsTabStop="False"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                    <ContentPresenter x:Name="PlaceholderTextContentPresenter"
                                                      Content="{TemplateBinding PlaceholderText}"
                                                      Padding="{TemplateBinding Padding}"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 快捷提问胶囊：悬停微抬升，按下轻微回缩 -->
                <Style x:Key="AiChipStyle" TargetType="Button">
                    <Setter Property="Background" Value="{ThemeResource AiChipFillBrush}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource AiChipStrokeBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="15"/>
                    <Setter Property="Padding" Value="11,0"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="ChipRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="ChipTr"/>
                                    </Grid.RenderTransform>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.18">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                                <VisualTransition From="PointerOver" To="Pressed" GeneratedDuration="0:0:0.08">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                    <Setter Target="StrokePlate.BorderBrush" Value="{ThemeResource AiCardHoverStrokeBrush}"/>
                                                    <Setter Target="ChipTr.TranslateY" Value="-1"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                    <Setter Target="ChipTr.ScaleX" Value="0.965"/>
                                                    <Setter Target="ChipTr.ScaleY" Value="0.965"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="ChipRoot.Opacity" Value="0.45"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="StrokePlate"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"/>
                                    <Border x:Name="HoverPlate" Opacity="0"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 分段控件内的单个分段（左侧动作组） -->
                <Style x:Key="AiSegmentStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="SegmentRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="SegTr"/>
                                    </Grid.RenderTransform>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.14">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                    <Setter Target="SegTr.ScaleX" Value="0.97"/>
                                                    <Setter Target="SegTr.ScaleY" Value="0.97"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="SegmentRoot.Opacity" Value="0.4"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="HoverPlate" Opacity="0"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{ThemeResource AiSegmentHoverBrush}"/>
                                    <!-- 内容不拉伸：由 ContentPresenter 自身居中，避免横向 StackPanel 被拉伸后靠左 -->
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 低调的文字/图标按钮：完全隐形，仅悬停时浮出一层淡光 -->
                <Style x:Key="AiGhostStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="9,4"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="GhostRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="GhostTr"/>
                                    </Grid.RenderTransform>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.14">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverPlate.Opacity" Value="1"/>
                                                    <Setter Target="GhostTr.ScaleX" Value="0.94"/>
                                                    <Setter Target="GhostTr.ScaleY" Value="0.94"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="GhostRoot.Opacity" Value="0.4"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="HoverPlate" Opacity="0"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 发送：渐变实心圆，悬停扩散光晕，按下回缩 -->
                <Style x:Key="AiSendStyle" TargetType="Button">
                    <Setter Property="Width" Value="32"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="16"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B9CFF" Offset="0"/>
                                <GradientStop Color="#2D6EFA" Offset="0.55"/>
                                <GradientStop Color="#5B4BF0" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="SendRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="SendTr"/>
                                    </Grid.RenderTransform>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.16">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                                <VisualTransition From="PointerOver" To="Pressed" GeneratedDuration="0:0:0.08">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="GlowRing.Opacity" Value="0.5"/>
                                                    <Setter Target="Highlight.Opacity" Value="0.18"/>
                                                    <Setter Target="SendTr.ScaleX" Value="1.045"/>
                                                    <Setter Target="SendTr.ScaleY" Value="1.045"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="GlowRing.Opacity" Value="0.5"/>
                                                    <Setter Target="Highlight.Opacity" Value="0.1"/>
                                                    <Setter Target="SendTr.ScaleX" Value="0.92"/>
                                                    <Setter Target="SendTr.ScaleY" Value="0.92"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="SendRoot.Opacity" Value="0.35"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Ellipse x:Name="GlowRing" Opacity="0" Margin="-3"
                                             Fill="{ThemeResource AiGlowBrush}"/>
                                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{TemplateBinding Background}"/>
                                    <Border x:Name="Highlight" Opacity="0"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="White"/>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 窗口底色纱层：浅色模式压一层系统灰，让白色卡片浮起来；深色模式保留 Mica 通透 -->
        <Border Grid.RowSpan="2" Background="{ThemeResource AiWindowBaseBrush}" IsHitTestVisible="False"/>

        <!-- ① 标题栏：玻璃条 + 品牌色块 + 型号徽章 -->
        <Grid Grid.Row="0" Height="48" ColumnDefinitions="*,Auto,138">
            <Grid x:Name="TitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6FA8FF" Offset="0"/>
                                    <GradientStop Color="#2D6EFA" Offset="0.5"/>
                                    <GradientStop Color="#7341F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#3DFFFFFF"/>
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="AI 视觉分析" FontSize="14" FontWeight="SemiBold" CharacterSpacing="-10"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TitleMetaText" Text="多模态截屏理解" FontSize="10.5" Margin="0,-1,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <Border x:Name="ModelBadge" Background="{ThemeResource AiChipFillBrush}"
                            BorderBrush="{ThemeResource AiChipStrokeBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="8,2" Height="20" VerticalAlignment="Center" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="{ThemeResource SnapFlowAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelBadgeText" Text="gpt-4o-mini" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Button Grid.Column="1" x:Name="SettingsButton" Style="{StaticResource AiGhostStyle}"
                    Margin="0,0,10,0" VerticalAlignment="Center" Click="OnOpenSettingsClick"
                    ToolTipService.ToolTip="配置 API 端点、密钥与默认提示词">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="接口配置" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,0"
                Background="{ThemeResource AiEdgeBrush}" IsHitTestVisible="False"/>

        <!-- ② 主内容：预览 / 弹性分隔条 / 对话工作区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="372" MinWidth="236"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：截屏预览 + 动作分组 -->
            <Grid x:Name="LeftPanel" Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="16,13,8,13">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,2,10">
                    <TextBlock Text="截屏预览" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="ImageInfoLabel" Grid.Column="1" Text="准备就绪" FontSize="10.5"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <Border x:Name="PreviewCard" Grid.Row="1" CornerRadius="14"
                        Background="{ThemeResource AiCardFillBrush}"
                        BorderBrush="{ThemeResource AiCardStrokeBrush}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Border CornerRadius="10" Margin="7"
                                Background="{ThemeResource AiInsetFillBrush}"
                                BorderBrush="{ThemeResource AiCardStrokeBrush}" BorderThickness="1">
                            <!-- 整图适配显示：点击弹出全尺寸查看窗口，不再在小窗里滚动看局部 -->
                            <Grid x:Name="PreviewHost" Tapped="OnPreviewTapped"
                                  PointerEntered="OnPreviewPointerEntered" PointerExited="OnPreviewPointerExited"
                                  ToolTipService.ToolTip="点击查看全尺寸大图">
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"/>
                                <Button x:Name="PreviewZoomButton" Style="{StaticResource AiGhostStyle}"
                                        Visibility="Collapsed" Opacity="0" Background="#B31E1E24"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Click="OnPreviewZoomClick"
                                        ToolTipService.ToolTip="弹出全尺寸查看窗口">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="11.5" Foreground="White"/>
                                        <TextBlock Text="放大查看" FontSize="11.5" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- 顶部一道极细高光，模拟玻璃受光 -->
                        <Border Height="1" Margin="16,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{ThemeResource AiSheenBrush}" Opacity="0.7"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                    <!-- 两段等宽：内容各自居中，中间一根发丝分隔，整组与预览卡左右边缘严格对齐 -->
                    <Border Height="36" CornerRadius="11" Background="{ThemeResource AiSegmentTrackBrush}">
                        <Grid ColumnDefinitions="*,Auto,*" Margin="3,0">
                            <Button x:Name="PinButton" Style="{StaticResource AiSegmentStyle}" Click="OnPinClick"
                                    ToolTipService.ToolTip="把这张截图钉在桌面最上层">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE718;" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="钉在桌面" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Grid.Column="1" Width="1" Height="14" VerticalAlignment="Center"
                                       Fill="{ThemeResource AiChipStrokeBrush}"/>
                            <Button x:Name="CopyImageButton" Grid.Column="2" Style="{StaticResource AiSegmentStyle}"
                                    Click="OnCopyImageClick" ToolTipService.ToolTip="复制截屏图片到剪贴板">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="复制图片" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="拖拽分隔条调整宽度 · 双击复位" FontSize="10" TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 弹性分隔条 -->
            <Grid x:Name="Splitter" Grid.Column="1" Background="Transparent"
                  PointerEntered="OnSplitterPointerEntered"
                  PointerExited="OnSplitterPointerExited"
                  PointerPressed="OnSplitterPointerPressed"
                  PointerMoved="OnSplitterPointerMoved"
                  PointerReleased="OnSplitterPointerReleased"
                  DoubleTapped="OnSplitterDoubleTapped"
                  ToolTipService.ToolTip="按住拖拽调整分栏宽度 · 双击复位">
                <Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource AiCardStrokeBrush}"/>
                <Border x:Name="SplitterHoverLine" Width="3" CornerRadius="1.5" Opacity="0"
                        HorizontalAlignment="Center" Background="{ThemeResource SnapFlowAccentBrush}"
                        IsHitTestVisible="False"/>
                <Border x:Name="SplitterGrip" Width="4" Height="34" CornerRadius="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource AiChipStrokeBrush}"
                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="GripTr"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- 右栏：快捷提问 / 结果卡片 / 输入胶囊 -->
            <Grid x:Name="RightPanel" Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Padding="2,13,16,12">
                <!-- 快捷提问 -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" Margin="0,0,0,10">
                    <StackPanel x:Name="ChipsHost" Orientation="Horizontal" Spacing="7">
                        <Button x:Name="ChipCode" Style="{StaticResource AiChipStyle}" Click="OnQuickPromptClick"
                                Tag="precise|请分析并提取这张图里的代码，说明核心逻辑，并指出潜在 Bug 或优化建议。">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="{ThemeResource SnapFlowSkyBrush}"/>
                                <TextBlock Text="代码排查" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChipTable" Style="{StaticResource AiChipStyle}" Click="OnQuickPromptClick"
                                Tag="precise|请把这张截图中的所有表格数据转换为标准的 Markdown 表格格式输出。">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="▦" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SnapFlowAccentBrush}"/>
                                <TextBlock Text="转 Markdown 表格" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChipSummary" Style="{StaticResource AiChipStyle}" Click="OnQuickPromptClick"
                                Tag="请完整提炼这张截图中的文字重点与核心观点，条理清晰地列出要点。">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C1;" FontSize="11" Foreground="#8B5CF6"/>
                                <TextBlock Text="要点摘要" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChipTranslate" Style="{StaticResource AiChipStyle}" Click="OnQuickPromptClick"
                                Tag="precise|请将这张截图中的所有文本翻译为地道流畅的中文。">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource SnapFlowSuccessBrush}"/>
                                <TextBlock Text="中文翻译" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 结果卡片 -->
                <Border x:Name="ResultCard" Grid.Row="1" CornerRadius="16"
                        Background="{ThemeResource AiCardFillBrush}"
                        BorderBrush="{ThemeResource AiCardStrokeBrush}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Margin="16,11,9,8" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="7"
                                        Background="{ThemeResource SnapFlowAccentLightBrush}">
                                    <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource SnapFlowAccentBrush}"/>
                                </Border>
                                <TextBlock Text="分析结果" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Border Height="19" CornerRadius="9.5" Padding="7,0" VerticalAlignment="Center"
                                        Background="{ThemeResource AiChipFillBrush}"
                                        BorderBrush="{ThemeResource AiChipStrokeBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button x:Name="RenderToggleButton" Style="{StaticResource AiGhostStyle}"
                                        Height="28" Padding="10,0" CornerRadius="9" Content="原文"
                                        Click="OnToggleRenderClick"
                                        ToolTipService.ToolTip="切换 Markdown 渲染 / 原文显示"/>
                                <Button x:Name="CopyResultButton" Style="{StaticResource AiGhostStyle}"
                                        Width="28" Height="28" Padding="0" CornerRadius="9"
                                        Click="OnCopyResultClick" ToolTipService.ToolTip="复制回答">
                                    <Grid>
                                        <FontIcon x:Name="CopyGlyph" Glyph="&#xE8C8;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <FontIcon x:Name="CopyDoneGlyph" Glyph="&#xE73E;" FontSize="12" Visibility="Collapsed"
                                                  Foreground="{ThemeResource SnapFlowSuccessBrush}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="ResultScroller" Padding="16,0,16,14"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <StackPanel x:Name="ResultHost">
                                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13" LineHeight="22"
                                               IsTextSelectionEnabled="True" IsTabStop="False"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel x:Name="ResultMarkdown" Spacing="8" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 空态 -->
                            <StackPanel x:Name="EmptyHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="13" MaxWidth="300" IsHitTestVisible="False">
                                <Border Width="56" Height="56" CornerRadius="18" HorizontalAlignment="Center"
                                        Background="{ThemeResource AiChipFillBrush}"
                                        BorderBrush="{ThemeResource AiCardStrokeBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE946;" FontSize="20"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="等待分析" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="选择上方快捷提问，或在下方输入你的问题"
                                               FontSize="11.5" LineHeight="17" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 加载态：极光描边环 + 呼吸文案 + 骨架条 -->
                            <StackPanel x:Name="LoadingHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="14" MaxWidth="340" Visibility="Collapsed">
                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{ThemeResource AiSkeletonBrush}" StrokeThickness="2.5"/>
                                    <Grid x:Name="LoaderRing" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Grid.RenderTransform>
                                        <Ellipse StrokeThickness="2.5">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#002D6EFA" Offset="0"/>
                                                    <GradientStop Color="#002D6EFA" Offset="0.4"/>
                                                    <GradientStop Color="#662D6EFA" Offset="0.78"/>
                                                    <GradientStop Color="#FF6FA8FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="LoadingStatusText" Text="正在调用多模态视觉模型…"
                                           FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Spacing="8" Width="300" HorizontalAlignment="Center">
                                    <Border x:Name="SkeletonA" Height="8" CornerRadius="4" Opacity="0.5"
                                            Background="{ThemeResource AiSkeletonBrush}"/>
                                    <Border x:Name="SkeletonB" Height="8" CornerRadius="4" Opacity="0.5" Width="196"
                                            HorizontalAlignment="Left" Background="{ThemeResource AiSkeletonBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 输入胶囊 -->
                <Grid x:Name="ComposerHost" Grid.Row="2" Margin="0,12,0,0">
                    <Border x:Name="ComposerGlow" CornerRadius="16" BorderThickness="1" Opacity="0"
                            IsHitTestVisible="False" BorderBrush="{ThemeResource SnapFlowAccentBorderBrush}"
                            Background="{ThemeResource AiGlowBrush}"/>
                    <Border x:Name="Composer" CornerRadius="16" Height="48"
                            Background="{ThemeResource AiInputFillBrush}"
                            BorderBrush="{ThemeResource AiInputStrokeBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" Padding="8,0">
                            <TextBox x:Name="PromptInput" Style="{StaticResource AiInputBoxStyle}"
                                     PlaceholderText="追问或输入分析需求…"
                                     KeyDown="OnPromptKeyDown"
                                     GotFocus="OnPromptFocus" LostFocus="OnPromptFocusOut"
                                     AutomationProperties.Name="分析提问输入框"/>
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AiSendStyle}"
                                    Margin="6,0,0,0" VerticalAlignment="Center" Click="OnSendClick"
                                    ToolTipService.ToolTip="发送 (Enter) · 分析中点击可停止">
                                <Grid>
                                    <FontIcon x:Name="SendGlyph" Glyph="&#xE724;" FontSize="12" Foreground="White"/>
                                    <Border x:Name="StopGlyph" Width="9" Height="9" CornerRadius="2.5"
                                            Background="White" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="4,7,2,0" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ComposerHint" Text="Enter 发送 · Shift + Enter 换行" FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="HintRight" Grid.Column="1" Text="多轮追问保留上下文 · 回答流式输出" FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 窗口内描边：给玻璃材质一道极细的高光边 -->
        <Border Grid.RowSpan="2" IsHitTestVisible="False" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource AiEdgeBrush}"/>
    </Grid>
</Window>
