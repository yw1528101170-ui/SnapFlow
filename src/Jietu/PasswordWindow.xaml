<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jietu.PasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jietu"
    Title="密码库">
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区 -->
        <Grid x:Name="TitleBar" Height="40" Background="Transparent">
            <TextBlock Text="密码库" FontSize="13" FontWeight="SemiBold"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="LockBadge" Text="已锁定" FontSize="11" Margin="70,0,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>

        <!-- ============ 解锁 / 创建视图（锁定态显示） ============ -->
        <Grid x:Name="UnlockPanel" Grid.Row="1" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                <StackPanel MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="16,12">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE72E;" FontSize="17" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UnlockTitle" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="UnlockModeBadge" Text="解锁" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="UnlockSubtitle" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Spacing="9">
                        <PasswordBox x:Name="MasterBox" PlaceholderText="主密码" MaxLength="128"
                                     KeyDown="OnMasterKeyDown" PasswordChanged="OnMasterPasswordChanged"/>

                        <!-- 创建态：强度 + 要求清单 + 确认 -->
                        <StackPanel x:Name="StrengthPanel" Spacing="7" Visibility="Collapsed">
                            <StackPanel Spacing="5">
                                <ProgressBar x:Name="StrengthBar" Maximum="100" Value="0" Height="4" CornerRadius="2"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="StrengthText" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="StrengthLabel" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ReqLength" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="ReqMixed" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <PasswordBox x:Name="ConfirmBox" PlaceholderText="再输入一次主密码" MaxLength="128"
                                     Visibility="Collapsed" KeyDown="OnMasterKeyDown"
                                     PasswordChanged="OnConfirmPasswordChanged"/>
                        <TextBlock x:Name="MatchHint" FontSize="11.5" Visibility="Collapsed"/>
                    </StackPanel>

                    <InfoBar x:Name="UnlockError" IsOpen="False" IsClosable="False" Severity="Error"/>
                    <InfoBar x:Name="CreateWarning" IsOpen="False" IsClosable="False" Severity="Warning"
                             Title="主密码无法找回"
                             Message="忘记主密码等于永久丢失库内全部数据。请不要使用其他网站的密码，并务必牢记。"/>

                    <Button x:Name="UnlockButton" HorizontalAlignment="Stretch" Height="34"
                            Click="OnUnlockClick" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="HelloButton" Content="使用 Windows Hello 解锁" HorizontalAlignment="Stretch"
                            Click="OnHelloClick" Visibility="Collapsed"/>

                    <TextBlock x:Name="HelloHint" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="启用 Windows Hello 后可以免输主密码快速解锁（在锁定界面点击上方按钮即可开启）。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 密码库主视图（解锁态显示） ============ -->
        <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Grid Grid.Row="0" Margin="12,4,12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索标题、用户名或网址…"
                         TextChanged="OnSearchChanged" VerticalAlignment="Center" CornerRadius="6"/>
                <Button x:Name="NewButton" Grid.Column="1" Content="＋ 新建" Click="OnNewEntry" CornerRadius="6"/>
                <Button x:Name="GenButton" Grid.Column="2" Content="生成器" Click="OnToggleGenerator" CornerRadius="6"/>
                <DropDownButton x:Name="MoreButton" Grid.Column="3" Content="⋯" CornerRadius="6" Padding="8,4">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入 CSV…" Click="OnImportCsv"/>
                            <MenuFlyoutItem Text="加密备份…" Click="OnBackupVault"/>
                            <MenuFlyoutItem Text="明文导出 CSV…（危险）" Click="OnExportCsv"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="修改主密码…" Click="OnChangeMasterPassword"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="LockButton" Grid.Column="4" Content="锁定" Click="OnLockClick" CornerRadius="6"/>
            </Grid>

            <!-- 列表 + 详情 -->
            <Grid Grid.Row="1" Margin="12,0,12,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="EntryList" Grid.Column="0" SelectionChanged="OnEntrySelected"
                          Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VaultRow">
                            <Grid Margin="10,8" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel x:Name="DetailRoot" Spacing="10" Margin="4,4,4,20" MaxWidth="460" HorizontalAlignment="Stretch">
                        <!-- 生成器面板 -->
                        <Border x:Name="GeneratorPanel" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="密码生成器" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="GenLengthBox" Text="16" Header="长度" Width="70"/>
                                    <CheckBox x:Name="GenPassphrase" Content="密码短语（4 个随机单词）" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <CheckBox x:Name="GenLower" Content="小写" IsChecked="True"/>
                                    <CheckBox x:Name="GenUpper" Content="大写" IsChecked="True"/>
                                    <CheckBox x:Name="GenDigits" Content="数字" IsChecked="True"/>
                                    <CheckBox x:Name="GenSymbols" Content="符号" IsChecked="True"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="GenOutput" IsReadOnly="True" HorizontalAlignment="Stretch" FontFamily="Consolas"/>
                                    <Button Content="生成" Click="OnGeneratePassword"/>
                                    <Button Content="使用" Style="{StaticResource AccentButtonStyle}" Click="OnUseGenerated"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 编辑区 -->
                        <TextBlock x:Name="DetailHeader" Text="条目详情" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox x:Name="KindBox" Header="类型" Text="登录" IsReadOnly="True"/>
                        <TextBox x:Name="TitleBox" Header="标题" PlaceholderText="例如 GitHub"/>
                        <TextBox x:Name="UsernameBox" Header="用户名 / 邮箱"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Header="密码"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                <Button Content="显示" Click="OnToggleReveal"/>
                                <Button Content="复制" Click="OnCopyPassword"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="PasswordTextBox" Header="密码" FontFamily="Consolas" Visibility="Collapsed"/>
                        <TextBox x:Name="UrlBox" Header="网址"/>
                        <TextBox x:Name="TotpBox" Header="TOTP 密钥（Base32 或 otpauth:// 链接）"/>
                        <Grid ColumnSpacing="8" x:Name="TotpDisplayRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock x:Name="TotpCode" Text="------" FontSize="22" FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <Button Grid.Column="1" Content="复制验证码" Click="OnCopyTotp" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="TagsBox" Header="标签（逗号分隔）"/>
                        <TextBox x:Name="NotesBox" Header="备注" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="OnSaveEntry"/>
                            <Button Content="复制用户名" Click="OnCopyUsername"/>
                            <Button Content="删除" Click="OnDeleteEntry"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyPane" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="没有条目" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="创建第一个条目" Click="OnNewEntry" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
