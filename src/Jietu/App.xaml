<Application
    x:Class="Jietu.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 深色模式主题资源 -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SnapFlowToolbarBgBrush" Color="#EB202023"/>
                    <SolidColorBrush x:Key="SnapFlowToolbarBorderBrush" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="SnapFlowToolbarShadowBrush" Color="#66000000"/>
                    <SolidColorBrush x:Key="SnapFlowToolGlyphBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="SnapFlowToolHoverBgBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="SnapFlowToolPressedBgBrush" Color="#30FFFFFF"/>
                    <SolidColorBrush x:Key="SnapFlowDividerBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="SnapFlowCardBorderBrush" Color="#22FFFFFF"/>

                    <!-- 剪贴板历史：Apple 风格的玻璃层级色板（深色） -->
                    <SolidColorBrush x:Key="HistFieldFillBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="HistFieldStrokeBrush" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="HistFocusRingBrush" Color="#B32D6EFA"/>
                    <SolidColorBrush x:Key="HistRowHoverBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="HistRowStrokeBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="HistSelectionFillBrush" Color="#292D6EFA"/>
                    <SolidColorBrush x:Key="HistSelectionStrokeBrush" Color="#4A2D6EFA"/>
                    <SolidColorBrush x:Key="HistSegmentTrackBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="HistSegmentThumbBrush" Color="#3DFFFFFF"/>
                    <SolidColorBrush x:Key="HistBadgeFillBrush" Color="#1F2D6EFA"/>
                    <SolidColorBrush x:Key="HistThumbFillBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="HistPanelFillBrush" Color="#E61B1B1E"/>
                    <SolidColorBrush x:Key="HistDividerBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="HistEdgeBrush" Color="#1AFFFFFF"/>

                    <!-- 设置中枢：Apple 风格侧栏 / 内嵌分组卡片（深色） -->
                    <SolidColorBrush x:Key="SetPaneFillBrush" Color="#F2262629"/>
                    <SolidColorBrush x:Key="SetContentFillBrush" Color="#F21C1C1E"/>
                    <SolidColorBrush x:Key="SetPaneEdgeBrush" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="SetCardFillBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="SetCardStrokeBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="SetRowHoverBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="SetIconTileFillBrush" Color="#212D6EFA"/>
                    <SolidColorBrush x:Key="SetNoteFillBrush" Color="#0FFFFFFF"/>

                    <!-- 快捷键按钮全套状态：默认/悬停/按下/录制/键帽（深色） -->
                    <SolidColorBrush x:Key="HotkeyFillBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyFillHoverBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyFillPressedBrush" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyStrokeBrush" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyStrokeHoverBrush" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyStrokePressedBrush" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyRecordingFillBrush" Color="#142D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyRecordingStrokeBrush" Color="#992D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyRecordingGlowBrush" Color="#1F2D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyKeycapFillBrush" Color="#2EFFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyKeycapStrokeBrush" Color="#4DFFFFFF"/>

                    <!-- AI 视觉工作台：玻璃卡片 / 胶囊输入 / 加载骨架（深色） -->
                    <SolidColorBrush x:Key="AiCardFillBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="AiCardStrokeBrush" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="AiCardHoverStrokeBrush" Color="#38FFFFFF"/>
                    <SolidColorBrush x:Key="AiInsetFillBrush" Color="#0CFFFFFF"/>
                    <SolidColorBrush x:Key="AiChipFillBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="AiChipStrokeBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="AiInputFillBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="AiInputStrokeBrush" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="AiSkeletonBrush" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="AiEdgeBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="AiSheenBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="AiSegmentTrackBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="AiGlowBrush" Color="#332D6EFA"/>
                    <SolidColorBrush x:Key="AiWindowBaseBrush" Color="#1F000000"/>
                    <SolidColorBrush x:Key="AiSegmentHoverBrush" Color="#1FFFFFFF"/>
                </ResourceDictionary>
                <!-- 浅色模式主题资源 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SnapFlowToolbarBgBrush" Color="#F4FFFFFF"/>
                    <SolidColorBrush x:Key="SnapFlowToolbarBorderBrush" Color="#1F000000"/>
                    <SolidColorBrush x:Key="SnapFlowToolbarShadowBrush" Color="#16000000"/>
                    <SolidColorBrush x:Key="SnapFlowToolGlyphBrush" Color="#383838"/>
                    <SolidColorBrush x:Key="SnapFlowToolHoverBgBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="SnapFlowToolPressedBgBrush" Color="#22000000"/>
                    <SolidColorBrush x:Key="SnapFlowDividerBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="SnapFlowCardBorderBrush" Color="#14000000"/>

                    <!-- 剪贴板历史：Apple 风格的玻璃层级色板（浅色） -->
                    <SolidColorBrush x:Key="HistFieldFillBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="HistFieldStrokeBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="HistFocusRingBrush" Color="#B32D6EFA"/>
                    <SolidColorBrush x:Key="HistRowHoverBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="HistRowStrokeBrush" Color="#10000000"/>
                    <SolidColorBrush x:Key="HistSelectionFillBrush" Color="#242D6EFA"/>
                    <SolidColorBrush x:Key="HistSelectionStrokeBrush" Color="#3D2D6EFA"/>
                    <SolidColorBrush x:Key="HistSegmentTrackBrush" Color="#0D000000"/>
                    <SolidColorBrush x:Key="HistSegmentThumbBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HistBadgeFillBrush" Color="#172D6EFA"/>
                    <SolidColorBrush x:Key="HistThumbFillBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="HistPanelFillBrush" Color="#F7FFFFFF"/>
                    <SolidColorBrush x:Key="HistDividerBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="HistEdgeBrush" Color="#14000000"/>

                    <!-- 设置中枢：Apple 风格侧栏 / 内嵌分组卡片（浅色） -->
                    <SolidColorBrush x:Key="SetPaneFillBrush" Color="#F2EAEDF1"/>
                    <SolidColorBrush x:Key="SetContentFillBrush" Color="#F6F8FAFC"/>
                    <SolidColorBrush x:Key="SetPaneEdgeBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="SetCardFillBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="SetCardStrokeBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="SetRowHoverBrush" Color="#08000000"/>
                    <SolidColorBrush x:Key="SetIconTileFillBrush" Color="#162D6EFA"/>
                    <SolidColorBrush x:Key="SetNoteFillBrush" Color="#07000000"/>

                    <!-- 快捷键按钮全套状态：默认/悬停/按下/录制/键帽（浅色） -->
                    <SolidColorBrush x:Key="HotkeyFillBrush" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyFillHoverBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyFillPressedBrush" Color="#F2E9EDF4"/>
                    <SolidColorBrush x:Key="HotkeyStrokeBrush" Color="#1F000000"/>
                    <SolidColorBrush x:Key="HotkeyStrokeHoverBrush" Color="#592D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyStrokePressedBrush" Color="#802D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyRecordingFillBrush" Color="#0D2D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyRecordingStrokeBrush" Color="#992D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyRecordingGlowBrush" Color="#172D6EFA"/>
                    <SolidColorBrush x:Key="HotkeyKeycapFillBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HotkeyKeycapStrokeBrush" Color="#33000000"/>

                    <!-- AI 视觉工作台：玻璃卡片 / 胶囊输入 / 加载骨架（浅色） -->
                    <SolidColorBrush x:Key="AiCardFillBrush" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="AiCardStrokeBrush" Color="#1F000000"/>
                    <SolidColorBrush x:Key="AiCardHoverStrokeBrush" Color="#3D000000"/>
                    <SolidColorBrush x:Key="AiInsetFillBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="AiChipFillBrush" Color="#0D000000"/>
                    <SolidColorBrush x:Key="AiChipStrokeBrush" Color="#17000000"/>
                    <SolidColorBrush x:Key="AiInputFillBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AiInputStrokeBrush" Color="#26000000"/>
                    <SolidColorBrush x:Key="AiSkeletonBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="AiEdgeBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="AiSheenBrush" Color="#8CFFFFFF"/>
                    <SolidColorBrush x:Key="AiSegmentTrackBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="AiGlowBrush" Color="#2E2D6EFA"/>
                    <SolidColorBrush x:Key="AiWindowBaseBrush" Color="#A6EDF0F4"/>
                    <SolidColorBrush x:Key="AiSegmentHoverBrush" Color="#A6FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- SnapFlow 官方极光蓝紫品牌与语义色彩系统 -->
            <Color x:Key="SnapFlowAccentColor">#2D6EFA</Color>
            <SolidColorBrush x:Key="SnapFlowAccentBrush" Color="#2D6EFA"/>
            <SolidColorBrush x:Key="SnapFlowAccentLightBrush" Color="#1A2D6EFA"/>
            <SolidColorBrush x:Key="SnapFlowAccentBorderBrush" Color="#4D2D6EFA"/>
            <SolidColorBrush x:Key="SnapFlowAccentHoverBrush" Color="#3D7BFA"/>
            <SolidColorBrush x:Key="SnapFlowAccentPressedBrush" Color="#1E5FE6"/>
            <SolidColorBrush x:Key="SnapFlowVioletBrush" Color="#7341F5"/>
            <SolidColorBrush x:Key="SnapFlowSkyBrush" Color="#00B9FF"/>
            <SolidColorBrush x:Key="SnapFlowSuccessBrush" Color="#10B981"/>
            <SolidColorBrush x:Key="SnapFlowDangerBrush" Color="#EF4444"/>
            <SolidColorBrush x:Key="SnapFlowWarningBrush" Color="#F59E0B"/>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,0,0,0"/>
            </Style>

            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="17"/>
            </Style>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="HotkeyBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="148"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="PlaceholderText" Value="按下快捷键"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,3.5"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <!-- 实体键帽质感徽章：随主题取色，底部加厚描边模拟键帽侧壁 -->
            <Style x:Key="HotkeyKeycapStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HotkeyKeycapFillBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource HotkeyKeycapStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1,1,1,2"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="8,2.5"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!--
                快捷键录制按钮：自带完整视觉状态机。
                CommonStates 走默认/悬停/按下（轻微回弹）/禁用；
                RecordingStates 是代码里 GoToState("Recording") 的自定义态，
                品牌色描边 + 外圈呼吸光晕，两个状态组互不干扰可叠加。
            -->
            <Style x:Key="HotkeyButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="140"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="{ThemeResource HotkeyFillBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource HotkeyStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="RecordingGlow"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{ThemeResource HotkeyRecordingGlowBrush}"
                                        BorderBrush="{ThemeResource HotkeyRecordingStrokeBrush}"
                                        BorderThickness="1.5"
                                        Opacity="0"/>
                                <Border x:Name="RootBorder"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RootScale"/>
                                    </Border.RenderTransform>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyFillHoverBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyStrokeHoverBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyFillPressedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyStrokePressedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.06"/>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.06"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="RecordingStates">
                                        <!-- 空的 Idle 态让代码里 GoToState("Idle") 能把这个组带回去（状态名须模板内唯一，不能叫 Normal） -->
                                        <VisualState x:Name="Idle"/>
                                        <VisualState x:Name="Recording">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyRecordingStrokeBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HotkeyRecordingFillBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="RecordingGlow" Storyboard.TargetProperty="Opacity"
                                                                 From="0.9" To="0.15" Duration="0:0:1.1"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TagChipItemStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,3,6,3"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <!-- 历史列表行：Apple 式「悬停/选中各自独立的光学层」，切换时由生成过渡平滑交叉淡入 -->
            <Style x:Key="HistoryItemStyle" TargetType="ListViewItem">
                <Setter Property="Margin" Value="8,2,8,2"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="10"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RootScale"/>
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                            <VisualTransition From="PointerOver" To="Pressed" GeneratedDuration="0:0:0.08">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1"/>
                                                <Setter Target="RootScale.ScaleX" Value="0.985"/>
                                                <Setter Target="RootScale.ScaleY" Value="0.985"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                                <Setter Target="HoverLayer.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                                <Setter Target="HoverLayer.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                                <Setter Target="RootScale.ScaleX" Value="0.985"/>
                                                <Setter Target="RootScale.ScaleY" Value="0.985"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectLayer.Opacity" Value="1"/>
                                                <Setter Target="RootScale.ScaleX" Value="0.985"/>
                                                <Setter Target="RootScale.ScaleY" Value="0.985"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="SelectLayer" CornerRadius="10" Opacity="0"
                                        Background="{ThemeResource HistSelectionFillBrush}"
                                        BorderBrush="{ThemeResource HistSelectionStrokeBrush}"
                                        BorderThickness="1"/>
                                <Border x:Name="HoverLayer" CornerRadius="10" Opacity="0"
                                        Background="{ThemeResource HistRowHoverBrush}"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
